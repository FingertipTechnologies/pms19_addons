<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_ft_project_weekly_review_form" model="ir.ui.view">
            <field name="name">ft.project.weekly.review.form</field>
            <field name="model">ft.project.weekly.review</field>
            <field name="arch" type="xml">
                <form string="Weekly Review">
                    <sheet>
                        <group>
                            <group>
                                <field name="project_id" invisible="context.get('default_project_id')" readonly="id"/>
                                <field name="week_start" readonly="id"/>
                                <field name="week_label"/>
                            </group>
                            <group>
                                <field name="reviewer_id"/>
                                <field name="last_updated"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>
                        <div class="o_ft_review_challenges">
                            <label for="challenges" class="o_form_label fw-bold"/>
                            <field name="challenges" widget="html" required="1" nolabel="1"
                                   placeholder="Challenges faced this week..."/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ft_project_weekly_review_list" model="ir.ui.view">
            <field name="name">ft.project.weekly.review.list</field>
            <field name="model">ft.project.weekly.review</field>
            <field name="arch" type="xml">
                <list string="Weekly Reviews" default_order="week_start desc, id desc">
                    <field name="project_id"/>
                    <field name="week_label"/>
                    <field name="week_start" optional="hide"/>
                    <field name="reviewer_id"/>
                    <field name="last_updated"/>
                </list>
            </field>
        </record>

        <record id="view_ft_project_weekly_review_search" model="ir.ui.view">
            <field name="name">ft.project.weekly.review.search</field>
            <field name="model">ft.project.weekly.review</field>
            <field name="arch" type="xml">
                <search string="Weekly Reviews">
                    <field name="project_id"/>
                    <field name="week_label"/>
                    <field name="reviewer_id"/>
                    <filter name="my_reviews" string="My Reviews"
                            domain="[('reviewer_id', '=', uid)]"/>
                    <group>
                        <filter name="group_project" string="Project"
                                context="{'group_by': 'project_id'}"/>
                        <filter name="group_week" string="Week"
                                context="{'group_by': 'week_label'}"/>
                        <filter name="group_reviewer" string="Reviewer"
                                context="{'group_by': 'reviewer_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- All projects' weekly reviews, newest week first. Same rights as
             the project tab: only Technical Architect / Delivery Head can
             create or edit; everybody else reads. -->
        <record id="action_ft_project_weekly_review" model="ir.actions.act_window">
            <field name="name">Review</field>
            <field name="res_model">ft.project.weekly.review</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ft_project_weekly_review_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No weekly review yet</p>
                <p>One review per project per week, written by the Technical
                   Architect or the Delivery Head.</p>
            </field>
        </record>

        <menuitem id="menu_ft_project_weekly_review"
                  name="Review"
                  parent="project.menu_main_pm"
                  action="action_ft_project_weekly_review"
                  sequence="25"/>

    </data>
</odoo>
