<odoo>
    <record id="view_partner_form_inherit_custom" model="ir.ui.view">
        <field name="name">res.partner.form.custom.fields</field>
        <field name="model">res.partner</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='category_id']" position="after">
<!--                <field name="name" string="Account Name" invisible="is_company == False"/>-->
                <field name="account_status_id" invisible="is_company == False"/>
                <field name="activity_count_custom" invisible="is_company == False"/>
                <!-- Annual Revenue is one of the details that must be filled in
                     before an Opportunity or Activity can be created for the
                     account (see _missing_account_fields). The others - Employee
                     Count (x_Employee), Website and Legal Name (the account
                     name) - are already elsewhere on this form. -->
                <field name="annual_revenue" invisible="1"/>
                <field name="annual_revenue_currency_id" invisible="1"/>
                <field name="annual_revenue_amount" invisible="is_company == False"/>
                <field name="annual_revenue_range" invisible="is_company == False"/>
                <field name="company_linkedin" invisible="is_company == False"/>
<!--                <field name="phone" invisible="is_company == False"/>-->
                <field name="industry_id" invisible="is_company == False"/>
                <field name="rating" invisible="is_company == False"/>
                <field name="contact_date" invisible="is_company == False"/>

                <field name="number_of_contacts"
                        invisible="is_company == False"/>

                    <field name="connected_contacts"
                        widget="many2many_tags"
                        invisible="is_company == False"/>

                <!-- Audit datetimes, shown at the end below Connected Contacts -->
                <field name="create_date" string="Created On" readonly="1"/>
                <field name="write_date" string="Last Modified On" readonly="1"/>
            </xpath>

            <!-- Salesperson moved up from the Sales & Purchase tab.
                 Anchored on `vat` (the only occurrence in the form) rather
                 than on `phone`: in Odoo 19 the first `phone` sits in the
                 label-less header <div>, so a field moved there renders as a
                 bare avatar with no caption and reads as missing. -->
            <xpath expr="//field[@name='vat']" position="before">
                <field name="user_id" position="move"/>
            </xpath>

            <!-- Dedicated rich-text Description tab, beside Internal Notes,
                 shown only for companies. -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Description" name="company_description"
                      invisible="is_company == False">
                    <field name="description" nolabel="1"
                           placeholder="Company description..."/>
                </page>
            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                <field name="duplicate_check" invisible="is_company == False"/>
                <field name="company_eid" invisible="is_company == False"/>
                <field name="employees" invisible="is_company == False"/>
                <field name="first_activity_datetime" readonly="True"/>
                <field name="last_activity_datetime" readonly="True"/>
                <field name="pain_points" invisible="is_company == False"/>
                <field name="source_id" invisible="is_company == False"/>
                <field name="sub_vertical" invisible="is_company == False"/>
                <field name="working_date" invisible="is_company == False"/>
            </xpath>

            <xpath expr="//field[@name='website']" position="before">
                <field name="email_1" widget="email" invisible="is_company == True"/>
                <field name="email_2" widget="email" invisible="is_company == True"/>

            </xpath>

            <!-- Website is mandatory for Companies, optional for Individuals -->
            <xpath expr="//field[@name='website']" position="attributes">
                <attribute name="required">is_company == True</attribute>
            </xpath>

            <!-- Mobile and Mobile 1, each on its own row under Phone in the
                 header block, matching how Email and Phone are laid out there.

                 Anchored on the row DIV, not on the `phone` field: a field
                 inserted after `phone` lands inside that same flex row, so the
                 numbers end up squeezed side by side sharing Phone's icon and
                 with no caption of their own - which reads as the field being
                 missing rather than merely unlabelled. `w-md-50` narrows the
                 match to the two header rows (Email and Phone), so this cannot
                 drift onto the `phone` fields in the child-contact subviews
                 further down the same form. -->
            <xpath expr="//div[hasclass('w-md-50')][field[@name='phone']]" position="after">
                <div class="d-flex align-items-baseline w-md-50">
                    <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile"/>
                    <field name="mobile" class="w-100" widget="phone" placeholder="Mobile"/>
                </div>
                <div class="d-flex align-items-baseline w-md-50">
                    <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile 1"/>
                    <field name="mobile_1" class="w-100" widget="phone" placeholder="Mobile 1"/>
                </div>
            </xpath>

            <!-- Same two numbers on the CHILD CONTACT card in the Contacts tab.
                 That card is a separate kanban template that only ever rendered
                 `phone`, so a contact whose number lives in Mobile showed a card
                 with no number at all - the parent form above being fixed does
                 not reach it. Each row is `t-if`'d like the stock Email/Phone
                 rows, so nothing is drawn for a contact that has no such number. -->
            <xpath expr="//kanban//div[field[@name='phone']]" position="after">
                <div t-if="record.mobile.raw_value" class="text-truncate">
                    <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile"/>
                    <field name="mobile"/>
                </div>
                <div t-if="record.mobile_1.raw_value" class="text-truncate">
                    <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile 1"/>
                    <field name="mobile_1"/>
                </div>
            </xpath>

            <!-- And on the popup form opened by clicking one of those cards,
                 so the numbers can actually be read and edited there too.
                 Anchored through `child_ids`/form rather than the form's
                 `string` attribute: Odoo rejects `string` as an inheritance
                 selector because it is translatable. -->
            <xpath expr="//field[@name='child_ids']/form//div[field[@name='phone']]" position="after">
                <div class="d-flex align-items-baseline">
                    <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile"/>
                    <field name="mobile" widget="phone" class="w-100" placeholder="Mobile"/>
                </div>
                <div class="d-flex align-items-baseline">
                    <i class="fa fa-fw me-1 fa-mobile text-primary" title="Mobile 1"/>
                    <field name="mobile_1" widget="phone" class="w-100" placeholder="Mobile 1"/>
                </div>
            </xpath>

            <xpath expr="//group[@name='misc']//field[@name='industry_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>


            <xpath expr="//field[@name='vat']" position="after">
                <field name="contact_eid" invisible="is_company == True"/>
                <field name="contact_account" invisible="is_company == True"/>
                <field name="contact_linkedin" invisible="is_company == True"/>
                <field name="company_id" invisible="is_company == True"/>
                <field name="department" invisible="is_company == True"/>
            </xpath>

        </field>
    </record>

    <!-- Contacts list view: enforce column order
         Name, Email, Phone, Mobile, Annual Revenue, Activities, Employees,
         Website, Industry, State, Salesperson, Account Status,
         Company LinkedIn. -->
    <record id="view_partner_tree_inherit_custom_order" model="ir.ui.view">
        <field name="name">res.partner.list.custom.order</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">

            <!-- Email, then Phone, right after Name.
                 Anchored on `display_name`, not `complete_name`: Odoo 19's
                 base list carries both, and `complete_name` is the
                 column_invisible one that sits *before* the visible Name
                 column. Anchoring there inserted every column below in front
                 of Name and pushed it to the far right of the list. -->
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="email" position="move"/>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <field name="phone" position="move"/>
            </xpath>

            <!-- Mobile, back in its pre-migration slot right after Phone.
                 Odoo 19 dropped res.partner.mobile from core; this module
                 re-declares it, so the column exists again. -->
            <xpath expr="//field[@name='phone']" position="after">
                <field name="mobile" optional="show" class="o_force_ltr"/>
            </xpath>

            <!-- Annual Revenue (monetary needs its currency field available).
                 Anchored on `mobile`, not `phone`, so it lands after the Mobile
                 column added just above rather than in front of it. -->
            <xpath expr="//field[@name='mobile']" position="after">
                <field name="annual_revenue_currency_id" column_invisible="1"/>
                <field name="annual_revenue_amount" optional="show"/>
            </xpath>

            <!-- Employees. The Activities column is shown automatically at the
                 far right for activity-enabled models, so we don't add our own
                 (it would appear twice). -->
            <xpath expr="//field[@name='annual_revenue_amount']" position="after">
                <field name="employees" optional="show"/>
            </xpath>

            <!-- Website -->
            <xpath expr="//field[@name='employees']" position="after">
                <field name="website" optional="show"/>
            </xpath>

            <!-- Industry -->
            <xpath expr="//field[@name='website']" position="after">
                <field name="industry_id" optional="show"/>
            </xpath>

            <!-- State, then Salesperson -->
            <xpath expr="//field[@name='industry_id']" position="after">
                <field name="state_id" position="move"/>
            </xpath>
            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='state_id']" position="after">
                <field name="user_id" position="move"/>
            </xpath>

            <!-- Account Status, then Company LinkedIn -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="account_status_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='account_status_id']" position="after">
                <field name="company_linkedin" optional="show"/>
            </xpath>

            <!-- Created On / Last Modified On as the last data columns -->
            <xpath expr="//field[@name='company_linkedin']" position="after">
                <field name="create_date" string="Created On" optional="show"/>
                <field name="write_date" string="Last Modified On" optional="show"/>
            </xpath>

            <!-- Keep the remaining base columns out of the default set -->
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='country_id']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>

        </field>
    </record>

    <!-- CRM > Customers opens on Kanban instead of List.

         The action's default view is the FIRST entry of its `view_ids`
         (ordered by `sequence`), not the first mode in the `view_mode`
         string - see ir.actions.act_window._compute_views, which builds
         `views` from view_ids and only appends modes that view_ids does not
         already cover. base.action_partner_form declares list/kanban/form as
         view_ids, so editing view_mode would have no effect; the sequences
         are what has to change.

         Only crm.res_partner_menu_customer points at this action, so the
         Contacts app is unaffected. -->
    <record id="base.action_partner_form_view1" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
    </record>
    <record id="base.action_partner_tree_view1" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
    </record>
</odoo>
