<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_project_project_form_date_extension" model="ir.ui.view">
            <field name="name">project.project.form.date.extension</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                    <button name="action_view_date_extension_requests" type="object"
                            class="oe_stat_button" icon="fa-calendar-plus-o">
                        <field name="date_extension_request_count" widget="statinfo"
                               string="Date Extensions"/>
                    </button>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
