<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Form view -->
        <record id="view_project_date_extension_request_form" model="ir.ui.view">
            <field name="name">project.date.extension.request.form</field>
            <field name="model">project.date.extension.request</field>
            <field name="arch" type="xml">
                <form string="Date Extension Request">
                    <header>
                        <button name="action_submit_request" type="object"
                                string="Request" class="btn-primary"
                                invisible="not can_submit"/>
                        <button name="action_approve" type="object"
                                string="Approve" class="btn-primary"
                                invisible="state != 'request'"
                                groups="project_date_extension.group_project_date_extension_approver"/>
                        <button name="action_reject" type="object"
                                string="Reject" class="btn-secondary"
                                invisible="state != 'request'"
                                groups="project_date_extension.group_project_date_extension_approver"/>
                        <button name="action_reset_to_draft" type="object"
                                string="Reset to Draft"
                                invisible="state != 'rejected'"
                                groups="project_date_extension.group_project_date_extension_approver"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,request,approved,rejected"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <!-- Preponement: the rescheduled date is EARLIER than
                             the current one. Only the selected date moves;
                             later dates are never pulled backwards and it
                             never counts as a delay. -->
                        <div class="alert alert-info mb-3" role="alert"
                             invisible="not is_preponement">
                            <b>Preponement.</b> The rescheduled date is earlier than the
                            current planned date. Only the selected stage date will move;
                            later planned dates stay where they are and no delay is counted.
                        </div>
                        <group>
                            <group>
                                <field name="project_id" options="{'no_create': True}"
                                       readonly="state != 'draft'"/>
                                <field name="stage_id" readonly="1"/>
                                <field name="allowed_stage_ids" invisible="1"/>
                                <field name="allowed_date_ids" invisible="1"/>
                                <!-- The stage dropdown: the project's lifecycle
                                     stages from the current one onward that have
                                     a planned date set. Picking one fills the
                                     (hidden) Date to Extend and the Current
                                     Date with the stage's OWN date - the one the
                                     project must have reached it by, as named
                                     on the project form (REG: Regression Date,
                                     SRV: Sandbox Review Date, ...) and as the
                                     Overdue flag reads it - never the next
                                     stage's date (STAGE_PLANNED_DATE_FIELD). -->
                                <field name="stage_to_extend_id" options="{'no_create': True}"
                                       readonly="state != 'draft'"/>
                                <!-- The field approval actually moves. Filled in
                                     from the stage above and read-only while a
                                     stage is chosen; picked by hand otherwise.
                                     Always shown, not only for AMC / General
                                     projects: Go Live and Support End belong to
                                     no stage (1.7.0), so an Implementation
                                     project can reschedule them only here, with
                                     the stage left empty. -->
                                <field name="date_to_extend_id" options="{'no_create': True}"
                                       context="{'ld_project_id': project_id}"
                                       required="not stage_to_extend_id"
                                       readonly="stage_to_extend_id or state != 'draft'"/>
                                <field name="milestone_id" invisible="1"/>
                                <field name="is_approver" invisible="1"/>
                                <field name="can_submit" invisible="1"/>
                                <field name="requester_id"
                                       options="{'no_create': True}"
                                       readonly="not is_approver or state != 'draft'"/>
                            </group>
                            <group>
                                <field name="current_date" readonly="1"/>
                                <field name="requested_date" readonly="state not in ('draft', 'request') or (state == 'request' and not is_approver)"/>
                                <field name="extension_days" readonly="1"
                                       decoration-danger="extension_days > 0"
                                       decoration-info="extension_days &lt; 0"/>
                                <field name="is_preponement" readonly="1"
                                       invisible="not is_preponement"/>
                                <field name="delay_days" invisible="1"/>
                            </group>
                        </group>
                        <group string="Reason">
                            <!-- colspan is what makes this box the width of the
                                 form. An inner group is a two column grid —
                                 `grid-template-columns: fit-content(150px)
                                 minmax(0, 1fr)`, the first column being for
                                 labels — and a field spans ONE of them unless
                                 it is told otherwise. A labelled field is
                                 bumped to two by the compiler; `nolabel="1"`
                                 skips that, so this one sat in the 150px label
                                 column and wrapped the reason after three
                                 words. Spanning both columns gives it the
                                 sheet.

                                 rows, because the stock text widget opens at
                                 two (TextField.defaultProps.rowCount) — barely
                                 deeper than a one-line field for what is the
                                 case FOR the extension, and the only thing an
                                 approver reads before deciding. The box still
                                 grows with what is typed; this only sets where
                                 it starts. -->
                            <field name="reason" nolabel="1" colspan="2" rows="8"
                                    placeholder="Explain why this date extension is requested..."
                                    readonly="state != 'draft'"/>
                        </group>
                        <!-- Preview of what approval will do to the later
                             planned dates (same iteration as the approval
                             itself, so they always agree). -->
                        <group string="Impact on later dates" invisible="not date_to_extend_id or not requested_date">
                            <field name="downstream_impact" nolabel="1" colspan="2" readonly="1"/>
                        </group>
                        <group string="Extension History" invisible="state == 'draft'">
                            <field name="approver_id" readonly="1"/>
                            <field name="decision_date" readonly="1"/>
                            <field name="approval_comment" readonly="1" invisible="state != 'approved' and not approval_comment"/>
                            <field name="rejection_reason" readonly="1" invisible="state != 'rejected' and not rejection_reason"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List / tree view -->
        <record id="view_project_date_extension_request_list" model="ir.ui.view">
            <field name="name">project.date.extension.request.list</field>
            <field name="model">project.date.extension.request</field>
            <field name="arch" type="xml">
                <list string="Date Extension Requests" decoration-success="state == 'approved'"
                      decoration-danger="state == 'rejected'" decoration-muted="state == 'draft'">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="stage_id" optional="hide"/>
                    <field name="stage_to_extend_id"/>
                    <field name="date_to_extend_id" optional="hide"/>
                    <field name="current_date"/>
                    <field name="requested_date"/>
                    <field name="extension_days" sum="Total"
                           decoration-danger="extension_days > 0"
                           decoration-info="extension_days &lt; 0"/>
                    <field name="is_preponement" optional="hide"/>
                    <field name="delay_days" optional="hide" sum="Delay"/>
                    <field name="requester_id"/>
                    <field name="approver_id" optional="hide"/>
                    <field name="decision_date" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'approved'"
                           decoration-danger="state == 'rejected'"
                           decoration-muted="state == 'draft'"/>
                </list>
            </field>
        </record>

        <!-- Search view -->
        <record id="view_project_date_extension_request_search" model="ir.ui.view">
            <field name="name">project.date.extension.request.search</field>
            <field name="model">project.date.extension.request</field>
            <field name="arch" type="xml">
                <search string="Search Date Extension Requests">
                    <field name="name"/>
                    <field name="project_id"/>
                    <field name="stage_to_extend_id"/>
                    <field name="date_to_extend_id"/>
                    <field name="requester_id"/>
                    <separator/>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Approved" name="filter_approved" domain="[('state', '=', 'approved')]"/>
                    <filter string="Rejected" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                    <separator/>
                    <filter string="Extensions" name="filter_extensions" domain="[('extension_days', '>', 0)]"/>
                    <filter string="Preponements" name="filter_preponements" domain="[('is_preponement', '=', True)]"/>
                    <separator/>
                    <filter string="My Requests" name="filter_my_requests" domain="[('requester_id', '=', uid)]"/>
                    <group>
                        <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                        <filter string="Stage to be Extended" name="group_stage" context="{'group_by': 'stage_to_extend_id'}"/>
                        <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_project_date_extension_request" model="ir.actions.act_window">
            <field name="name">Date Extension Requests</field>
            <field name="res_model">project.date.extension.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_project_date_extension_request_search"/>
            <field name="context">{'search_default_filter_draft': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smart_action">
                    Create a Date Extension Request
                </p>
                <p>
                    Pick the stage to be extended and the rescheduled date.
                    Once approved by an authorized Admin, the stage's planned
                    date on the Project (the date the stage must be reached
                    by) is updated automatically and every later planned
                    date moves by the same number of days.
                </p>
            </field>
        </record>

        <!-- Menu: 98, immediately before Change Request (99), at the end of
             the PMS bar. It sat at 60, which is Test Plans' sequence, so it
             landed in the middle of the QA menus it has nothing to do with. -->
        <menuitem id="menu_project_date_extension_request"
                  name="Date Extensions"
                  parent="project.menu_main_pm"
                  action="action_project_date_extension_request"
                  sequence="98"/>

    </data>
</odoo>
