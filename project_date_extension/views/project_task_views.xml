<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Point 6: let users tie a task to the custom milestone (stage)
             that governs its date rules. The milestone's approved / extended
             Due Date then controls the timesheet cut-off for this task. -->
        <record id="view_task_form2_date_extension" model="ir.ui.view">
            <field name="name">project.task.form.date.extension</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <field name="date_deadline" position="after">
                    <field name="custom_milestone_id"
                           options="{'no_create': True}"/>
                </field>
            </field>
        </record>

    </data>
</odoo>
