<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_date_extension_decision_wizard_form" model="ir.ui.view">
        <field name="name">project.date.extension.decision.wizard.form</field>
        <field name="model">project.date.extension.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Date Extension Decision">
                <field name="decision" invisible="1"/>
                <field name="request_id" invisible="1"/>
                <group invisible="decision != 'approve'">
                    <field name="current_date" readonly="1"/>
                    <field name="requested_date" required="decision == 'approve'" string="Approved New Date"/>
                </group>
                <group>
                    <label for="comment" string="Approval Comment" invisible="decision != 'approve'"/>
                    <label for="comment" string="Rejection Reason" invisible="decision != 'reject'"/>
                    <field name="comment" nolabel="1" placeholder="Enter reason or comment for this decision..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Approve" type="object"
                            class="btn-primary" invisible="decision != 'approve'"/>
                    <button name="action_confirm" string="Reject" type="object"
                            class="btn-danger" invisible="decision != 'reject'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
