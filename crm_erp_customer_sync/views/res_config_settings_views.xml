<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_crm_erp"
            model="ir.ui.view">
        <field name="name">res.config.settings.view.form.crm.erp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                        string="CRM ERP Integration"
                        name="crm_erp_integration">
                    <block title="ERP API Configuration">
                        <setting
                                id="crm_erp_api_url_setting"
                                string="ERP Customer API URL"
                                help="ERP endpoint, e.g. https://erp-host/api/v1/customers/upsert.">
                            <field name="crm_erp_api_url" placeholder="https://erp.example.com/api/customers"/>
                        </setting>
                        <setting
                                id="crm_erp_api_token_setting"
                                string="ERP API Token"
                                help="Authentication token for ERP integration.">
                            <field name="crm_erp_api_token" password="True"/>
                        </setting>
                    </block>
                    <block title="ERP to CRM/PMS Existing Customer Code Sync">
                        <setting string="ERP-to-CRM Receiver Bearer Token">
                            <field name="crm_pms_receiver_token" password="True"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>