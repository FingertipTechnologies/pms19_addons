<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Week Master / List View
         ================================================================ -->
    <record id="view_week_list" model="ir.ui.view">
        <field name="name">project.week.list</field>
        <field name="model">qa_testapp.sprint</field>
        <field name="arch" type="xml">
            <!-- One row per week for the whole company, counting every
                 project. There is no Project column because a week has no
                 project: you pick one inside the week, to narrow the board.

                 EVERY column carries a pinned width, which is what fixes the
                 spacing. A column with a width has no room to grow (min and
                 max are both that width, see getWidthSpecs in web's
                 column_width_hook), so the leftover space is shared out evenly
                 between them all. Leave one column without a width — Week Name
                 was a char, which has a minimum but no maximum — and it is the
                 only one that can absorb the slack, so it stretches halfway
                 across the screen and squeezes the last column into an
                 ellipsis.

                 The rest of the summary is one click away under the column
                 picker rather than on screen by default.

                 ft_week_list colours the row for the week today falls in and
                 scrolls the list to it on open — the rows run oldest first, so
                 without it the list opened on weeks that are already over. See
                 static/src/week_list/week_list.js.

                 The page holds 200 rows rather than the default 80. Weeks
                 accumulate at one a week and are listed oldest first, so on
                 the default page the current week would drop off the end
                 somewhere in 2027 — onto page 2, where neither the colour nor
                 the scroll can reach it. 200 rows cost no extra round trips:
                 every summary column on this list comes from _tasks_by_week,
                 which reads the whole page in one query. -->
            <list string="Weeks" create="0" js_class="ft_week_list" limit="200">
                <!-- Never drawn. It is here so the renderer can read it off
                     the record: a field absent from the arch is not in
                     `record.data`, and this is the whole basis of the
                     highlight. -->
                <field name="is_current_week" column_invisible="1"/>
                <field name="name" string="Week" width="100px"/>
                <field name="start_date" string="Start Date" width="160px"/>
                <field name="end_date" string="End Date" width="160px"/>
                <field name="task_count" string="Total Tasks" width="120px"/>
                <field name="planned_task_count" string="Planned"
                       width="100px" optional="hide"/>
                <field name="working_task_count" string="Working"
                       width="100px" optional="hide"/>
                <field name="testing_task_count" string="Testing"
                       width="100px" optional="hide"/>
                <field name="completed_task_count" string="Completed"
                       width="110px" optional="hide"/>
                <field name="total_estimated_hours" string="Estimated"
                       widget="float_time" width="110px" optional="hide"/>
                <field name="open_estimated_hours" string="Open"
                       widget="float_time" width="100px" optional="hide"/>
                <field name="completed_actual_hours" string="Actual"
                       widget="float_time" width="100px" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ================================================================
         Week Detail View
         ================================================================ -->
    <record id="view_week_form" model="ir.ui.view">
        <field name="name">project.week.form</field>
        <field name="model">qa_testapp.sprint</field>
        <field name="arch" type="xml">
            <!-- No New, no Save / Discard: see ft_week_form
                 (static/src/week_form/week_form_view.js). -->
            <form string="Week" create="0" js_class="ft_week_form">
                <!-- Week Status, for the selected project only. Read off that
                     project's tasks due in the week (see board_status), so it
                     is shown rather than set. Shown as soon as a project is
                     selected, Planned if it has nothing due this week; hidden
                     for All Projects, since a week spanning projects at four
                     different stages has no one status. -->
                <header>
                    <field name="board_status" widget="statusbar" readonly="1"
                           invisible="not board_project_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="task_count" widget="statinfo" string="Tasks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <!-- Derived from the Monday: the continuous week
                             number, counted on through the turn of the year.
                             Not something to type. -->
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="week_dates">
                            <!-- A filter, not the week's owner: the week holds
                                 every project's work, and this narrows the
                                 summary and the board below to one of them.
                                 Empty — how the week opens — is all projects.
                                 Not stored, so it is nobody else's filter and
                                 there is nothing to save. -->
                            <field name="board_project_id"
                                   options="{'no_create': True}"
                                   placeholder="All Projects"/>
                            <!-- The Monday the week is, not something to move:
                                 weeks are created from task deadlines, and with
                                 no Save button an edit here would be saved
                                 without anyone asking for it. -->
                            <field name="start_date" readonly="1"/>
                            <!-- Always the Sunday of the start week, so it is
                                 shown rather than edited. -->
                            <field name="end_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Task Summary" name="task_summary">
                            <field name="task_count" string="Total Tasks"/>
                            <field name="completed_task_count" string="Completed Tasks"/>
                            <field name="working_task_count" string="Working Tasks"/>
                            <field name="planned_task_count" string="Planned Tasks"/>
                            <field name="testing_task_count" string="Testing Tasks"/>
                        </group>
                        <group string="Hour Tracking" name="hour_tracking">
                            <field name="total_estimated_hours" widget="float_time"/>
                            <field name="open_estimated_hours" widget="float_time"/>
                            <field name="completed_estimated_hours" widget="float_time"/>
                            <field name="completed_actual_hours" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="week_tasks" string="Tasks">
                            <!-- Every task due inside the week, whatever its
                                 project — each card names the project it came
                                 from, unless Project above has narrowed the
                                 board to one — as a board with
                                 one column per stage. The widget draws the
                                 columns itself: an embedded x2many is backed by
                                 a StaticList, which Odoo cannot group, so a
                                 plain <kanban> here would render one flat grid
                                 of cards with no columns and nothing to drag
                                 between. Dropping a card writes stage_id and
                                 refreshes the summary above.

                                 No inline <list>: without one the field loads
                                 ids only, and the board reads its cards from
                                 get_board_data() instead. -->
                            <field name="week_task_ids" widget="week_task_board"
                                   class="o_week_board_field"
                                   options="{'filter_field': 'board_project_id', 'prefetch_pager': True}"
                                   readonly="1" nolabel="1"/>
                        </page>
                        <page name="assigned_tasks" string="Assigned Tasks">
                            <!-- The tasks explicitly linked to this week,
                                 through sprint_id on the task.

                                 create="false" drops the "Add a line" row: a
                                 week is not a place to raise new work. Tasks
                                 arrive here by being given a week elsewhere -
                                 dragging a card on the week board writes
                                 sprint_id - and existing rows stay editable.

                                 Project is the first column: the week itself
                                 belongs to no project, so each row has to name
                                 the project its work is for. -->
                            <field name="task_ids"
                                   context="{'default_project_id': board_project_id}">
                                <!-- Estimated and Deadline stay on the line:
                                     bt_project_customization requires both on
                                     every task, so they are the two values a
                                     week planner is most likely to have to
                                     correct. The deadline stays editable for
                                     anyone who needs a day other than the
                                     week's Sunday. -->
                                <list editable="bottom" create="false">
                                    <field name="project_id"
                                           options="{'no_create': True}"/>
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="user_ids" widget="many2many_avatar_user"/>
                                    <field name="estimated" widget="float_time"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ================================================================
         Week Kanban View
         ================================================================ -->
    <record id="view_week_kanban" model="ir.ui.view">
        <field name="name">project.week.kanban</field>
        <field name="model">qa_testapp.sprint</field>
        <field name="arch" type="xml">
            <!-- Ungrouped: a week had a status of its own to group by, and
                 it has been dropped — an All Projects week spans projects at
                 four different stages, so no single status could be true of
                 it. Ordered by start_date (the model's _order), so the cards
                 read as the calendar. -->
            <kanban class="o_kanban_small_column" create="0">
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="text-muted">
                                <field name="start_date"/> → <field name="end_date"/>
                            </div>
                            <div class="mt-1">
                                <span class="badge text-bg-secondary">
                                    <field name="task_count"/> Tasks
                                </span>
                                <span class="badge text-bg-light">
                                    <field name="total_estimated_hours" widget="float_time"/> Est.
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         Search
         ================================================================ -->
    <record id="view_week_search" model="ir.ui.view">
        <field name="name">project.week.search</field>
        <field name="model">qa_testapp.sprint</field>
        <field name="arch" type="xml">
            <search string="Weeks">
                <field name="name" string="Week"/>
                <separator/>
                <filter name="current_week" string="Current Week"
                        domain="[('start_date', '&lt;=', context_today().strftime('%Y-%m-%d')),
                                 ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group name="group_by">
                    <filter name="group_start_date" string="Week Start Date" context="{'group_by': 'start_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================================================
         Action & Menu
         ================================================================ -->
    <record id="action_week" model="ir.actions.act_window">
        <field name="name">Weeks</field>
        <field name="res_model">qa_testapp.sprint</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_week_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No weeks yet
            </p>
            <p>
                Weeks appear on their own: giving a task a deadline creates the
                week it falls in, numbered continuously from the first week of
                2026 — W53 is followed by W54 in January 2027, not by W1 again.
                A week runs Monday to Sunday, and moving a task to another week
                re-dates it to that week's Sunday.
            </p>
        </field>
    </record>

    <menuitem id="menu_ft_weeks"
              name="Weeks"
              parent="project.menu_main_pm"
              action="action_week"
              sequence="30"/>

</odoo>
