<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_comp_off_reject_form" model="ir.ui.view">
        <field name="name">employee.comp.off.reject.form</field>
        <field name="model">employee.comp.off.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Comp-Off">
                <group>
                    <field name="comp_off_id"/>
                    <field name="reason"
                           placeholder="Why is this Comp-Off request rejected?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object"
                            class="btn-danger" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

