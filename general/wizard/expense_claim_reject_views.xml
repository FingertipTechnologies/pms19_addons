<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_expense_claim_reject_form" model="ir.ui.view">
        <field name="name">employee.expense.claim.reject.form</field>
        <field name="model">employee.expense.claim.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Claim">
                <group>
                    <field name="claim_id"/>
                    <field name="reason" placeholder="Why is this claim rejected? The employee will see this on the claim."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-danger" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
