<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amc_monthly_report_list" model="ir.ui.view">
        <field name="name">ft.amc.monthly.report.list</field>
        <field name="model">ft.amc.monthly.report</field>
        <field name="arch" type="xml">
            <list create="0"
                  decoration-success="state == 'sent'"
                  decoration-info="state == 'queued'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'no_data'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="period_label" string="Period"/>
                <field name="period_start" optional="hide"/>
                <field name="period_end" optional="hide"/>
                <field name="task_count" string="Tasks"/>
                <field name="total_hours" sum="Total Hours" widget="float_time"/>
                <field name="sent_on" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-info="state == 'queued'"
                       decoration-danger="state == 'failed'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_amc_monthly_report_form" model="ir.ui.view">
        <field name="name">ft.amc.monthly.report.form</field>
        <field name="model">ft.amc.monthly.report</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_generate" type="object" string="Generate / Refresh"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'failed', 'no_data')"/>
                    <button name="action_send" type="object" string="Send Now"
                            class="btn-primary"
                            invisible="state not in ('draft', 'failed', 'no_data')"
                            confirm="Email this report (PDF + Excel) to the customer now?"/>
                    <button name="action_refresh_status" type="object" string="Refresh Email Status"
                            invisible="state != 'queued'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('failed', 'no_data')"/>
                    <button name="action_download_pdf" type="object" string="Download PDF"
                            icon="fa-file-pdf-o" invisible="not pdf_attachment_id"/>
                    <button name="action_download_xlsx" type="object" string="Download Excel"
                            icon="fa-file-excel-o" invisible="not xlsx_attachment_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,sent"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </div>
                    <group>
                        <group string="Report">
                            <field name="project_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="period_label" string="Period"/>
                            <field name="period_start" readonly="1"/>
                            <field name="period_end" readonly="1"/>
                            <field name="task_count" string="Approved Tasks"/>
                            <field name="total_hours" readonly="1" widget="float_time"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Email">
                            <field name="email_from" readonly="1"/>
                            <field name="recipient_emails" readonly="1"/>
                            <field name="cc_emails" readonly="1"/>
                            <field name="sent_on" readonly="1"/>
                            <field name="mail_id" readonly="1" invisible="not mail_id" options="{'no_open': True}"/>
                            <field name="pdf_attachment_id" invisible="1"/>
                            <field name="xlsx_attachment_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="stage_id"/>
                                    <field name="pwf_amc_approved_by_id" string="Approved By"/>
                                    <field name="pwf_amc_approved_on" string="Approved On"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_amc_monthly_report_search" model="ir.ui.view">
        <field name="name">ft.amc.monthly.report.search</field>
        <field name="model">ft.amc.monthly.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Queued" name="queued" domain="[('state', '=', 'queued')]"/>
                <filter string="Sent" name="sent" domain="[('state', '=', 'sent')]"/>
                <filter string="No Data" name="no_data" domain="[('state', '=', 'no_data')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="Period" name="filter_period_start" date="period_start"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period_start:month'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_amc_monthly_reports" model="ir.actions.act_window">
        <field name="name">AMC Monthly Timesheets</field>
        <field name="res_model">ft.amc.monthly.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_amc_monthly_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No monthly AMC reports yet</p>
            <p>Reports are created automatically on/after the 5th of each month for the previous
               month, or from the "AMC Monthly Timesheet" tab of an AMC project.</p>
        </field>
    </record>

    <!-- AMC tasks completed but not yet approved by the PM/TL. Uses the
         All Tasks list, which carries the bulk Approve / Reject buttons of
         ft_pms_planning_workflow. -->
    <record id="action_amc_tasks_to_approve" model="ir.actions.act_window">
        <field name="name">AMC Tasks Awaiting Approval</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('project_id.ft_project_type', '=', 'amc')]</field>
        <field name="context">{'search_default_pwf_amc_to_approve': 1}</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
    </record>

    <record id="action_amc_tasks_to_approve_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="project.open_view_all_tasks_list_view"/>
        <field name="act_window_id" ref="action_amc_tasks_to_approve"/>
    </record>

    <record id="action_amc_tasks_to_approve_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="20"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="project.view_task_form2"/>
        <field name="act_window_id" ref="action_amc_tasks_to_approve"/>
    </record>

    <menuitem id="menu_amc_root" name="AMC Reports" parent="project.menu_main_pm" sequence="60"
              groups="group_amc_manager,base.group_system,project.group_project_manager"/>
    <menuitem id="menu_amc_monthly_reports" name="AMC Monthly Timesheets" parent="menu_amc_root"
              action="action_amc_monthly_reports" sequence="10"/>
    <menuitem id="menu_amc_tasks_to_approve" name="Tasks Awaiting Approval" parent="menu_amc_root"
              action="action_amc_tasks_to_approve" sequence="20"/>
</odoo>
