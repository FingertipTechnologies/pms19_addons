<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Recipients, CC, sender and attachments are passed by
             ft.amc.monthly.report._process() through email_values. -->
        <record id="mail_template_amc_monthly_timesheet" model="mail.template">
            <field name="name">AMC: Monthly Timesheet Report</field>
            <field name="model_id" ref="model_ft_amc_monthly_report"/>
            <field name="subject">AMC Timesheet - {{ object.period_label }} - {{ object.project_id.name }}</field>
            <field name="email_from">{{ object.email_from or '' }}</field>
            <field name="reply_to">{{ object.email_from or '' }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="description">Monthly AMC timesheet (PDF + Excel) sent to the project customer for the previous month.</field>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:#333333;">
    <p style="margin:0 0 12px 0;">Dear <t t-out="object.partner_id.name or 'Customer'"/>,</p>
    <p style="margin:0 0 12px 0;">Please find attached the approved timesheet of your AMC project <b t-out="object.project_id.name or ''"/> for <t t-out="object.period_label or ''"/>, in PDF and Excel format.</p>
    <table cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:16px 0;font-size:14px;">
        <tr>
            <td style="padding:6px 24px 6px 0;color:#666666;white-space:nowrap;">Project</td>
            <td style="padding:6px 0;" t-out="object.project_id.name or '-'"/>
        </tr>
        <tr>
            <td style="padding:6px 24px 6px 0;color:#666666;white-space:nowrap;">Period</td>
            <td style="padding:6px 0;" t-out="object.period_label or '-'"/>
        </tr>
        <tr>
            <td style="padding:6px 24px 6px 0;color:#666666;white-space:nowrap;">Approved tasks</td>
            <td style="padding:6px 0;" t-out="object.task_count or 0"/>
        </tr>
        <tr>
            <td style="padding:6px 24px 6px 0;color:#666666;white-space:nowrap;">Total hours</td>
            <td style="padding:6px 0;" t-out="'%02d:%02d' % divmod(int(round((object.total_hours or 0.0) * 60)), 60)"/>
        </tr>
    </table>
    <p style="margin:0 0 12px 0;">For any questions, please contact the Project Manager.</p>
    <p style="margin:0 0 12px 0;">Regards,<br/><t t-out="object.company_id.name or ''"/></p>
    <p style="margin:16px 0 0 0;font-size:12px;color:#888888;">This is an automated monthly email summarizing the time entries for completed tasks during the reporting period. Please do not reply to this email.</p>
</div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>
    </data>
</odoo>
