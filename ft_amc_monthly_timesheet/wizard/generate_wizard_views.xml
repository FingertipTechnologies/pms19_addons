<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_amc_report_generate_wizard_form" model="ir.ui.view">
        <field name="name">ft.amc.report.generate.wizard.form</field>
        <field name="model">ft.amc.report.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate AMC Monthly Timesheet">
                <p class="text-muted">
                    Builds the report (PDF + Excel) of the chosen month for
                    preview, without emailing it. Pick any day of the month;
                    the whole calendar month is reported. An existing report
                    of that month is refreshed unless it was already sent.
                </p>
                <group>
                    <group>
                        <field name="project_id"/>
                        <field name="month"/>
                        <field name="period_label"/>
                    </group>
                    <group>
                        <field name="contract_start"/>
                        <field name="contract_end"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Generate" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
