<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Daily. THE ONE scheduled action of the AMC monthly automation. Every
         run does, in this order, each step in its own savepoint (a failure is
         logged and the next step still runs):
           1. create the CURRENT month's AMC milestone for every eligible AMC
              project (project.project._cron_ft_amc_create_monthly_milestones):
              on the 1st this creates them (requirement 36), every later run
              is a no-op for projects that already have one and a catch-up
              for projects that became eligible mid-month;
           2. from the Monthly E-mail Day (settings, default 7): send
              ft_amc_monthly_timesheet's reports of the PREVIOUS month for the
              months without a milestone
              (ft.amc.monthly.report._cron_send_monthly_reports);
           3. from the same day: complete - attach the task Excel and e-mail
              the month - the AMC milestones of the months that are over that
              are still Not Started with their send switch on
              (_cron_ft_amc_send_monthly_milestones). Switch off: left alone
              (manual flow).
         It supersedes the separate crons ir_cron_ft_amc_create_monthly_milestones
         and ir_cron_ft_amc_send_monthly (both deleted by the 19.0.1.6.0
         migration), the former ir_cron_ft_amc_send_monthly_milestones (deleted
         by the 19.0.1.5.0 migration) and ft_amc_monthly_timesheet
         .cron_amc_monthly_reports (archived by this module's install hook /
         migration, restored on uninstall). -->
    <record id="ir_cron_ft_amc_monthly" model="ir.cron">
        <field name="name">AMC: Monthly Milestones &amp; Timesheets</field>
        <field name="model_id" ref="project_custom_milestone.model_project_custom_milestone"/>
        <field name="state">code</field>
        <field name="code">model._cron_ft_amc_monthly()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
