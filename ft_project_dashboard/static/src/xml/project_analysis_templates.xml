<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ===================== PROJECT ANALYSIS TAB =====================
         The Analysis page on the project form: the dashboard's two card
         sections, Hours Utilisation and Tasks Summary, scoped to this one
         project.

         It borrows the board's `ftpd_` classes wholesale rather than defining a
         second look for the same cards: a KPI card that reads differently on
         the two screens would suggest the numbers behind it differ too, when
         they are literally the same query. project_analysis.scss carries only
         what has to change to sit inside a form notebook instead of filling a
         window — see the "embedded" modifier class on the root.
    -->
    <t t-name="ft_project_dashboard.ProjectAnalysis">
        <div class="ftpd_dashboard ftpd_dashboard--embedded">

            <!-- A project that has never been saved has no id, and every figure
                 below is a server query keyed on it. Say so, rather than showing
                 a page of zeroes that reads as a broken tab. -->
            <div t-if="state.unsaved" class="ftpd_embedded_notice">
                <i class="fa fa-info-circle me-2"/>Save the project to see its analysis.
            </div>

            <t t-else="">
                <!-- Range and person, the only two controls this tab has. The
                     board's Project / Manager / Status pickers are deliberately
                     absent: the project is the form's own record, and the whole
                     point of the tab is that it cannot be scoped to another. -->
                <div class="ftpd_header ftpd_header--embedded">
                    <div class="ftpd_periods">
                        <t t-foreach="periods" t-as="p" t-key="p.id">
                            <button class="ftpd_period_btn" type="button"
                                    t-att-class="{ 'ftpd_period_btn--active': state.period === p.id }"
                                    t-on-click="() => this.onPeriodChange(p.id)">
                                <t t-esc="p.label"/>
                            </button>
                        </t>
                    </div>
                    <div class="ftpd_custom" t-if="state.period === 'custom'">
                        <input type="date" class="ftpd_date" t-att-value="state.dateFrom"
                               t-on-change="(ev) => this.onCustomDateChange('dateFrom', ev)"/>
                        <span>→</span>
                        <input type="date" class="ftpd_date" t-att-value="state.dateTo"
                               t-on-change="(ev) => this.onCustomDateChange('dateTo', ev)"/>
                        <button class="ftpd_btn ftpd_btn--primary" type="button"
                                t-on-click="applyCustomRange">Apply</button>
                    </div>
                    <div class="ftpd_header_tools">
                        <!-- Narrowed to the people who booked time on THIS
                             project, unlike the board's picker: every other name
                             could only ever return a page of zeroes here. -->
                        <SearchSelect options="resourceOptions"
                                      value="state.personId"
                                      label="'Resource'"
                                      allLabel="'All Resources'"
                                      placeholder="'All Resources'"
                                      title="'Narrow every figure below to one person — type to search'"
                                      onSelect="(id) => this.onPersonChange(id)"/>
                        <button class="ftpd_btn" type="button" t-if="hasPersonFilter"
                                t-on-click="clearPersonFilter" title="Clear resource">
                            <i class="fa fa-times"/>
                        </button>
                        <button class="ftpd_btn" type="button"
                                t-on-click="refresh" title="Refresh">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                </div>

                <!-- Shown in place rather than raised: this tab sits inside a
                     form the user still has to be able to save. -->
                <div t-if="state.error" class="ftpd_embedded_error">
                    <i class="fa fa-exclamation-triangle me-2"/>
                    Analysis could not be loaded: <t t-esc="state.error"/>
                </div>

                <div class="ftpd_embedded_loading" t-if="state.loading">
                    <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
                </div>

                <div t-else="" class="ftpd_content">

                    <!-- ================ Hours Utilisation ================ -->
                    <!-- The board's section, scoped to this project. Read-only
                         by design on the two timesheet rows: they are computed
                         off timesheet lines grouped by employee, and there is no
                         single list of records behind a bucket to open. -->
                    <section class="ftpd_section">
                        <div class="ftpd_section_head">
                            <h2 class="ftpd_section_title">Hours Utilisation</h2>
                        </div>
                        <h3 class="ftpd_kpi_subhead">By Role<small> — every hour booked on this project in the selected period, split by job position</small></h3>
                        <div class="ftpd_kpi_grid"
                             t-att-class="hours.unclassified_hours ? 'ftpd_kpi_grid--six' : 'ftpd_kpi_grid--five'">
                            <KpiCard title="'Developer Hours'" value="hours.dev_hours" suffix="'h'"
                                     icon="'fa-code'" color="'#06B6D4'"
                                     tooltip="'Time booked on this project in the selected period by people in a developer role.'"/>
                            <KpiCard title="'PM Hours'" value="hours.pm_hours" suffix="'h'"
                                     icon="'fa-user-circle'" color="'#EC4899'"
                                     tooltip="'Time booked on this project in the selected period by people in a project-manager role.'"/>
                            <KpiCard title="'QA Hours'" value="hours.qa_hours" suffix="'h'"
                                     icon="'fa-bug'" color="'#8B5CF6'"
                                     tooltip="'Time booked on this project in the selected period by people in a QA role.'"/>
                            <KpiCard title="'BA Hours'" value="hours.ba_hours" suffix="'h'"
                                     icon="'fa-clipboard'" color="'#0EA5E9'"
                                     tooltip="'Time booked on this project in the selected period by people in a business-analyst role.'"/>
                            <KpiCard title="'Trainee Hours'" value="hours.trainee_hours" suffix="'h'"
                                     icon="'fa-graduation-cap'" color="'#0EA5E9'"
                                     tooltip="'Time booked by people whose Job Position starts with &quot;Trainee&quot;. Counted on its own, never inside Developer or QA Hours.'"/>
                            <!-- Hidden once it reaches zero, which is what will
                                 happen when every employee has a Job Position. -->
                            <KpiCard t-if="hours.unclassified_hours"
                                     title="'Unclassified Hours'" value="hours.unclassified_hours" suffix="'h'"
                                     icon="'fa-user-o'" color="'#94A3B8'"
                                     tooltip="'Time booked by people whose Job Position is unset, or is not one of the recognised delivery roles. Shown so this row accounts for every booked hour rather than silently falling short.'"/>
                        </div>

                        <!-- No Standup card here, unlike the board. Standup Hours
                             is "time on tasks in the Fingertip Standup project",
                             which on a per-project tab can only ever be zero or
                             the whole of it — a card that says nothing about the
                             project it is sitting on. -->
                        <h3 class="ftpd_kpi_subhead">By Activity<small> — time booked on this project in the selected period</small></h3>
                        <div class="ftpd_kpi_grid">
                            <KpiCard title="'Meeting Hours'" value="hours.meeting_hours" suffix="'h'"
                                     icon="'fa-calendar'" color="'#4F46E5'"
                                     tooltip="'Actual Hours on tasks whose Task Type is Internal Call or External Call. Internal + External, so the three stay additive.'"/>
                            <KpiCard title="'Internal Meeting Hours'" value="hours.internal_meeting_hours" suffix="'h'"
                                     icon="'fa-comments'" color="'#10B981'"
                                     tooltip="'Actual Hours on tasks whose Task Type is Internal Call.'"/>
                            <KpiCard title="'External Meeting Hours'" value="hours.external_meeting_hours" suffix="'h'"
                                     icon="'fa-phone'" color="'#EF4444'"
                                     tooltip="'Actual Hours on tasks whose Task Type is External Call.'"/>
                            <KpiCard title="'Non-Task Hours'" value="hours.non_task_hours" suffix="'h'"
                                     icon="'fa-question-circle-o'" color="'#64748B'"
                                     tooltip="'Time booked on this project but against no task. Real spend that no task-based figure can see, because there is no task to hold a total or a billing status. The By Role cards plus this one account for every hour booked on the project.'"/>
                        </div>

                        <!-- Task hour totals. Read off stored project.task
                             columns, which is why these are the only hour cards
                             that can carry a billing dimension — and why they
                             anchor on deadlines and completion dates rather than
                             on when the time was booked, so they will not tally
                             with the two rows above when a range is applied. -->
                        <h3 class="ftpd_kpi_subhead">Hours Summary<small> — due and completed work in the selected period</small></h3>
                        <div class="ftpd_kpi_grid">
                            <KpiCard title="'Total Estimated'" value="hours.hs_total_estimated" suffix="'h'"
                                     icon="'fa-hourglass-half'" color="'#3B82F6'"
                                     onClick="() => this.openHoursKpi('total_estimated')"
                                     tooltip="'Estimated hours of the tasks on this project whose Deadline falls in the selected period.'"/>
                            <KpiCard title="'Open Estimated'" value="hours.hs_open_estimated" suffix="'h'"
                                     icon="'fa-clock-o'" color="'#F59E0B'"
                                     onClick="() => this.openHoursKpi('open_estimated')"
                                     tooltip="'Estimated hours of open tasks whose Deadline falls in the selected period.'"/>
                            <KpiCard title="'Completed Estimated'" value="hours.hs_completed_estimated" suffix="'h'"
                                     icon="'fa-check-circle-o'" color="'#8B5CF6'"
                                     onClick="() => this.openHoursKpi('completed_estimated')"
                                     tooltip="'Estimated hours of tasks moved to Completed in the selected period.'"/>
                            <KpiCard title="'Completed Actual'" value="hours.hs_completed_actual" suffix="'h'"
                                     icon="'fa-check-circle'" color="'#10B981'"
                                     onClick="() => this.openHoursKpi('completed_actual')"
                                     tooltip="'Actual hours of tasks moved to Completed in the selected period.'"/>
                            <KpiCard title="'Billable Hours'" value="hours.hs_billable_hours" suffix="'h'"
                                     icon="'fa-money'" color="'#14B8A6'"
                                     onClick="() => this.openHoursKpi('billable_hours')"
                                     tooltip="'Actual hours of tasks due in the period, when the project is billable. Zero throughout on a non-billable project.'"/>
                            <KpiCard title="'Non-Billable Hours'" value="hours.hs_non_billable_hours" suffix="'h'"
                                     icon="'fa-ban'" color="'#EC4899'"
                                     onClick="() => this.openHoursKpi('non_billable_hours')"
                                     tooltip="'Actual hours of tasks due in the period, when the project is non-billable.'"/>
                        </div>
                    </section>

                    <!-- ================ Tasks Summary ================ -->
                    <!-- Counting tasks instead of hours. Each card anchors on its
                         own date — created on create date, due on deadline,
                         completed on completion date — so one range answers each
                         question correctly. -->
                    <section class="ftpd_section">
                        <div class="ftpd_section_head">
                            <h2 class="ftpd_section_title">Tasks Summary</h2>
                        </div>
                        <div class="ftpd_kpi_grid">
                            <KpiCard title="'Tasks Created'" value="tasks.tasks_created"
                                     onClick="() => this.openTaskKpi('tasks_created')"
                                     icon="'fa-plus-square'" color="'#4F46E5'"
                                     tooltip="'Tasks on this project whose creation date falls in the selected range. Click to list them.'"/>
                            <KpiCard title="'Tasks Due'" value="tasks.tasks_due"
                                     onClick="() => this.openTaskKpi('tasks_due')"
                                     icon="'fa-calendar-check-o'" color="'#F59E0B'"
                                     tooltip="'Tasks whose Deadline has arrived or passed and that are not yet Completed. A snapshot of today, deliberately not filtered by the selected period.'"/>
                            <KpiCard title="'Completed Tasks'" value="tasks.tasks_completed"
                                     onClick="() => this.openTaskKpi('tasks_completed')"
                                     icon="'fa-check-circle'" color="'#10B981'"
                                     tooltip="'Tasks completed in the range — in a folded stage with a completion date, excluding cancelled.'"/>
                            <KpiCard title="'Open Tasks'" value="tasks.tasks_open"
                                     onClick="() => this.openTaskKpi('tasks_open')"
                                     icon="'fa-folder-open'" color="'#06B6D4'"
                                     tooltip="'Tasks not in a folded stage. A snapshot of now, not filtered by the date range.'"/>
                            <KpiCard title="'Estimated Tasks'" value="tasks.tasks_estimated"
                                     onClick="() => this.openTaskKpi('tasks_estimated')"
                                     icon="'fa-hourglass-half'" color="'#3B82F6'"
                                     tooltip="'Tasks created in the range that carry an Estimated time. Estimated + Not Estimated = Tasks Created.'"/>
                            <KpiCard title="'Not Estimated'" value="tasks.tasks_not_estimated"
                                     onClick="() => this.openTaskKpi('tasks_not_estimated')"
                                     icon="'fa-hourglass-o'" color="'#EC4899'"
                                     tooltip="'Tasks created in the range with no Estimated time set.'"/>
                            <KpiCard title="'Completed on Timeline'" value="tasks.tasks_on_timeline"
                                     onClick="() => this.openTaskKpi('tasks_on_timeline')"
                                     icon="'fa-thumbs-o-up'" color="'#14B8A6'"
                                     tooltip="'Completed tasks that met their deadline, judged by calendar day. Tasks completed without a deadline cannot be judged and are excluded.'"/>
                            <KpiCard title="'Missed Timeline'" value="tasks.tasks_missed_timeline"
                                     onClick="() => this.openTaskKpi('tasks_missed_timeline')"
                                     icon="'fa-exclamation-triangle'" color="'#EF4444'"
                                     tooltip="'Completed tasks that finished after their deadline.'"/>
                        </div>
                        <!-- A partition: these add back up to Open Tasks exactly,
                             which is why the remainder gets a card of its own. -->
                        <h3 class="ftpd_kpi_subhead">Open Tasks by Stage<small> — a snapshot of now, like Open Tasks itself; adds up to it exactly</small></h3>
                        <div class="ftpd_kpi_grid"
                             t-att-class="tasks.tasks_other_open ? 'ftpd_kpi_grid--five' : ''">
                            <KpiCard title="'Not Yet Started'" value="tasks.tasks_planned"
                                     onClick="() => this.openTaskKpi('tasks_planned')"
                                     icon="'fa-hourglass-start'" color="'#64748B'"
                                     tooltip="'Open tasks sitting in a Planned stage — accepted but not begun.'"/>
                            <KpiCard title="'In Progress'" value="tasks.tasks_working"
                                     onClick="() => this.openTaskKpi('tasks_working')"
                                     icon="'fa-cogs'" color="'#4F46E5'"
                                     tooltip="'Open tasks in a Working stage — actively being delivered.'"/>
                            <KpiCard title="'Testing'" value="tasks.tasks_testing"
                                     onClick="() => this.openTaskKpi('tasks_testing')"
                                     icon="'fa-bug'" color="'#8B5CF6'"
                                     tooltip="'Open tasks in a Testing stage — built and under QA.'"/>
                            <KpiCard title="'Dependency'" value="tasks.tasks_dependency"
                                     onClick="() => this.openTaskKpi('tasks_dependency')"
                                     icon="'fa-hand-paper-o'" color="'#F59E0B'"
                                     tooltip="'Open tasks blocked on somebody else. Covers every stage whose name mentions a dependency.'"/>
                            <KpiCard t-if="tasks.tasks_other_open"
                                     title="'Other Open'" value="tasks.tasks_other_open"
                                     onClick="() => this.openTaskKpi('tasks_other_open')"
                                     icon="'fa-folder-open-o'" color="'#94A3B8'"
                                     tooltip="'Open tasks in none of the four stages beside this one, plus tasks with no stage set at all. Shown so the split adds up to Open Tasks rather than quietly falling short.'"/>
                        </div>
                    </section>

                </div>
            </t>
        </div>
    </t>

</templates>
