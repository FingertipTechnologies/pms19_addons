<odoo>
    <record id="view_crm_lead_form_custom" model="ir.ui.view">
        <field name="name">crm.lead.form.custom.fields.v18</field>
        <field name="model">crm.lead</field>
        <field name="priority">1</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Stage helper flags + remaining RIGHT column fields (after Tags) -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="is_cold_stage" invisible="1"/>
                <field name="require_qualified_fields" invisible="1"/>
                <field name="is_won_stage" invisible="1"/>

                <field name="lead_source" invisible="type != 'opportunity'"/>
                <field name="cus_campaign_id" invisible="type != 'opportunity'"/>
                <field name="source_amount" invisible="type != 'opportunity'"/>
                <field name="date_closed" invisible="type != 'opportunity'"/>
                <field name="create_uid" invisible="type != 'opportunity'"/>
                <field name="bdr_id" invisible="type != 'opportunity'"/>
                <field name="description_text" invisible="type != 'opportunity'"/>       
            </xpath>

            <!-- RIGHT column: bring mandatory fields to the top.
                 Expected Closing stays at the top, Closed Amount goes right
                 below it, and Salesperson is moved underneath them. -->
            <xpath expr="//group[@invisible=&quot;type == 'lead'&quot; and not(@name)]/div[field[@name='date_deadline']]" position="after">
                <!-- All stages except Won: shown as "Revenue", optional -->
                <field name="revenue"
                       string="Revenue"
                       invisible="type != 'opportunity' or is_won_stage"/>
                <!-- Won stage: renamed to "Closed Amount" and mandatory -->
                <field name="revenue"
                       string="Closed Amount"
                       invisible="type != 'opportunity' or not is_won_stage"
                       required="type == 'opportunity' and is_won_stage"/>
                <xpath expr="//group[@invisible=&quot;type == 'lead'&quot; and not(@name)]/field[@name='user_id']" position="move"/>
            </xpath>

            <!-- LEFT column: mandatory fields at the very top, above Contact -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="before">
                <field name="next_action"
                       invisible="type != 'opportunity'"
                       required="type == 'opportunity' and not is_cold_stage"
                       placeholder="Describe the next action (minimum 20 characters)"/>
                <field name="technology_id"
                       invisible="type != 'opportunity'"
                       required="type == 'opportunity' and require_qualified_fields"/>
                <field name="business_challenge"
                       invisible="type != 'opportunity'"
                       required="type == 'opportunity' and require_qualified_fields"/>
            </xpath>

            <!-- Contact is mandatory on an opportunity -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="required">type == 'opportunity'</attribute>
            </xpath>

            <!-- The mandatory account details, read-only, straight under the
                 Contact. They are what the save-time validation checks, so an
                 empty one here is exactly what is blocking the save - the
                 salesperson can see which detail and which account, rather than
                 only getting an error. Edit them on the account itself.
                 Legal Name is deliberately NOT shown: it is the account's
                 company name, so it would just repeat the Contact above. -->
            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="after">
                <field name="account_currency_id" invisible="1"/>
                <field name="account_annual_revenue" readonly="1"
                       invisible="type != 'opportunity'"/>
                <field name="account_employee_count" readonly="1"
                       invisible="type != 'opportunity'"/>
                <field name="account_website" widget="url" readonly="1"
                       invisible="type != 'opportunity'"/>
            </xpath>

            <!-- LEFT column: optional fields lower down -->
            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="number_of_users" invisible="type != 'opportunity'"/>
                <field name="cus_type" invisible="type != 'opportunity'"/>
            </xpath>

            <!-- Expected Revenue: mandatory from Qualified onward -->
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="required">type == 'opportunity' and require_qualified_fields</attribute>
            </xpath>

            <!-- Expected Closing: mandatory from Qualified onward -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="required">type == 'opportunity' and require_qualified_fields</attribute>
            </xpath>

            <!-- Remove Email & Phone from the opportunity layout -->
            <xpath expr="//group[@name='opportunity_partner']/label[@for='email_from']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/div[field[@name='email_from']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/label[@for='phone']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']/div[field[@name='phone']]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Mobile on the LEAD layout, directly under Phone. Odoo 19 dropped
                 crm.lead.mobile from core; this module re-declares it, so the
                 field and its stored numbers are available again. It is added
                 to the `lead_info` group only - the opportunity layout above
                 deliberately carries no Email/Phone, because an opportunity has
                 a mandatory Contact and the numbers are read from there. -->
            <xpath expr="//group[@name='lead_info']/div[field[@name='phone']]" position="after">
                <field name="mobile" widget="phone"/>
            </xpath>

            <!-- Source + Campaign on the Lead layout (the right column group
                 above is opportunity-only, so leads need their own copy). -->
            <xpath expr="//group[@name='lead_priority']/field[@name='tag_ids']" position="after">
                <field name="lead_source"/>
                <field name="cus_campaign_id"/>
            </xpath>

            <!-- Website mandatory on Leads (visible in the lead_partner group) -->
            <xpath expr="//group[@name='lead_partner']//field[@name='website']" position="attributes">
                <attribute name="required">type == 'lead'</attribute>
            </xpath>

            <!-- LinkedIn URL field, shown right after Website -->
            <xpath expr="//group[@name='lead_partner']//field[@name='website']" position="after">
                <field name="linkedin_url" widget="url" placeholder="e.g. https://www.linkedin.com/company/..."/>
            </xpath>

            <!-- Company Size + Location on the Lead layout, in the company
                 group next to the address they describe. Both are free text:
                 on a lead they hold what the prospect said, before an account
                 (with its Employee Count) or a structured address exists. -->
            <xpath expr="//group[@name='lead_partner']//field[@name='linkedin_url']" position="after">
                <field name="company_size" placeholder="e.g. 50-100 employees"/>
                <field name="employee_count"/>
                <field name="company_currency" invisible="1"/>
                <field name="annual_revenue_amount"/>
                <field name="lead_location" placeholder="e.g. Chennai, India"/>
            </xpath>

            <!-- Qualification block at the top of the Lead's right-hand group:
                 Created Date, Stage, Status, Timeline, Current System.
                 Stage is the stock `stage_id` - the same pipeline stage the
                 opportunity statusbar drives - shown here as a dropdown
                 because core hides that statusbar on leads
                 (invisible="type == 'lead'"). No new stage list is
                 introduced: the values, the team domain and the readonly rule
                 are the pipeline's own, so a change here is a real pipeline
                 stage change and survives the conversion to an opportunity. -->
            <xpath expr="//group[@name='lead_priority']/field[@name='priority']" position="before">
                <field name="lead_created_date"/>
                <field name="stage_id" id="stage_id_lead"
                       domain="['|', ('team_ids', 'in', team_id), ('team_ids', '=', False)]"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="won_status == 'lost' or not active"/>
                <field name="lead_status"/>
                <field name="acquisition_timeline"/>
                <field name="current_system"/>
            </xpath>

            <!-- LEAD layout: two continuous columns.
                 Core builds the lead form from four inner groups, which the
                 form grid lays out 2x2 - so the right-hand column started
                 level with the BOTTOM of the (much taller) company group.
                 That left Salesperson stranded at the foot of the left column
                 and an empty gap above Created Date. Consolidating into one
                 group per column fixes both: everything about the person and
                 the company on the left, everything about how the lead is
                 being worked on the right, Salesperson first.

                 Nodes are MOVED, never deleted, so any xpath another module
                 aims at them still resolves. `lead_info` keeps its invisible
                 blacklist / partner-update flags - the email and phone widgets
                 read those from anywhere in the view - and both emptied groups
                 stay in the arch as empty cells underneath the two real
                 columns. Opportunities are untouched: all four groups involved
                 here are the lead-only ones. -->

            <!-- LEFT column: contact details, between Company Name and the
                 address they belong with. -->
            <xpath expr="//group[@name='lead_partner']/field[@name='partner_name']" position="after">
                <xpath expr="//group[@name='lead_info']/label[@for='contact_name']" position="move"/>
                <xpath expr="//group[@name='lead_info']/div[field[@name='contact_name']]" position="move"/>
                <xpath expr="//group[@name='lead_info']/label[@for='email_from_group_lead_info']" position="move"/>
                <xpath expr="//group[@name='lead_info']/div[field[@name='email_from']]" position="move"/>
                <xpath expr="//group[@name='lead_info']/field[@name='email_cc']" position="move"/>
                <xpath expr="//group[@name='lead_info']/field[@name='function']" position="move"/>
                <xpath expr="//group[@name='lead_info']/label[@for='phone_group_lead_info']" position="move"/>
                <xpath expr="//group[@name='lead_info']/div[field[@name='phone']]" position="move"/>
                <!-- Mobile travels with Phone: it was added to `lead_info`
                     above, and moving a div does not carry its siblings. -->
                <xpath expr="//group[@name='lead_info']/field[@name='mobile']" position="move"/>
            </xpath>

            <!-- RIGHT column: Salesperson and Sales Team at the top, above the
                 qualification fields. -->
            <xpath expr="//group[@name='lead_priority']/field[@name='lead_created_date']" position="before">
                <xpath expr="//group[not(@name)][field[@name='team_id']]/field[@name='user_id']" position="move"/>
                <xpath expr="//group[not(@name)][field[@name='team_id']]/field[@name='team_id']" position="move"/>
            </xpath>

            <!-- ...and that block becomes the second column, level with the
                 first, instead of the second row of the grid. -->
            <xpath expr="//group[@name='lead_partner']" position="after">
                <xpath expr="//group[@name='lead_priority']" position="move"/>
            </xpath>

        </field>
    </record>

    <!-- BDR column in the opportunity list -->
    <record id="view_crm_lead_list_bdr" model="ir.ui.view">
        <field name="name">crm.lead.list.bdr</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="bdr_id" optional="show"/>
                <field name="lead_source" optional="hide"/>
                <field name="cus_campaign_id" optional="hide"/>
            </xpath>

            <!-- Mobile beside the stock Phone column. Shown by default: on most
                 of these records Mobile is the only number on file, so a hidden
                 column would read as "no contact number". -->
            <xpath expr="//field[@name='phone']" position="after">
                <field name="mobile" optional="show" class="o_force_ltr"/>
            </xpath>
        </field>
    </record>

    <!-- Source + Campaign columns in the Leads list (the CRM > Leads menu,
         restored in crm_menu_overrides.xml, and the new Marketing > Lead
         menu both open this same view). Mirrors what view_crm_lead_list_bdr
         above already does for the Pipeline list. -->
    <record id="view_crm_lead_list_source_campaign" model="ir.ui.view">
        <field name="name">crm.lead.list.source.campaign</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="lead_source" optional="show"/>
                <field name="cus_campaign_id" optional="show"/>
                <!-- Qualification columns. Stage / Status / Timeline are the
                     ones the team works the list by, so they show by default;
                     the rest are available from the optional-columns menu. -->
                <field name="lead_created_date" optional="hide"/>
                <field name="stage_id" optional="show"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="lead_status" optional="show"/>
                <field name="acquisition_timeline" optional="show"/>
                <field name="current_system" optional="hide"/>
                <field name="company_size" optional="hide"/>
                <field name="lead_location" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Source + Campaign search field + Group By in the Leads search view -->
    <record id="view_crm_lead_search_source_campaign" model="ir.ui.view">
        <field name="name">crm.lead.search.source.campaign</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <!-- Searchable fields -->
            <xpath expr="//search" position="inside">
                <field name="cus_campaign_id"/>
                <field name="lead_source"/>
                <field name="lead_status"/>
                <field name="lead_location"/>
            </xpath>

            <!-- Hide the stock UTM group-bys, same reasoning as the Pipeline
                 search view: this business fills in cus_campaign_id and
                 lead_source, not the stock campaign_id/medium_id/source_id,
                 so the un-hidden stock entries would just group everything
                 into "None". ('compaign' is spelt that way in core CRM.) -->
            <xpath expr="//filter[@name='compaign']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='medium']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='source']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- The working Source / Campaign group-bys, placed next to
                 Company rather than trailing at the end of the menu. -->
            <xpath expr="//filter[@name='company']" position="after">
                <filter name="group_lead_source" string="Source"
                        context="{'group_by': 'lead_source'}"/>
                <filter name="group_cus_campaign" string="Campaign"
                        context="{'group_by': 'cus_campaign_id'}"/>
                <filter name="group_lead_status" string="Status"
                        context="{'group_by': 'lead_status'}"/>
                <filter name="group_acquisition_timeline" string="Timeline"
                        context="{'group_by': 'acquisition_timeline'}"/>
                <filter name="group_current_system" string="Current System"
                        context="{'group_by': 'current_system'}"/>
                <filter name="group_lead_stage" string="Stage"
                        context="{'group_by': 'stage_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- BDR search field + Group By in the opportunity search view -->
    <record id="view_crm_lead_search_bdr" model="ir.ui.view">
        <field name="name">crm.lead.search.bdr</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <!-- Searchable fields -->
            <xpath expr="//search" position="inside">
                <field name="bdr_id"/>
                <field name="cus_campaign_id"/>
                <field name="lead_source"/>
            </xpath>

            <!-- Hide the stock UTM group-bys.
                 Core CRM offers "Campaign" (campaign_id), "Medium" (medium_id)
                 and "Source" (source_id) - none of which this business fills
                 in; it uses cus_campaign_id and lead_source instead. Leaving
                 both meant the Group By menu showed two "Campaign" and two
                 "Source" entries, and picking the stock one collapsed every
                 opportunity into a single "None" group.
                 ('compaign' is spelt that way in core CRM - not a typo here.) -->
            <xpath expr="//filter[@name='compaign']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='medium']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//filter[@name='source']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- The working Source / Campaign / BDR group-bys, placed inside
                 the Group By block next to Stage and Lost Reason rather than
                 trailing at the bottom of the menu. Filter NAMES are unchanged
                 so existing saved favourites keep working. -->
            <xpath expr="//filter[@name='lostreason']" position="after">
                <filter name="group_lead_source" string="Source"
                        context="{'group_by': 'lead_source'}"/>
                <filter name="group_cus_campaign" string="Campaign"
                        context="{'group_by': 'cus_campaign_id'}"/>
                <filter name="group_bdr" string="BDR"
                        context="{'group_by': 'bdr_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
