<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Show archived opportunities by default.

        Core hides archived records everywhere, and the CRM team wanted the
        archived (lost or hand-archived) opportunities visible as soon as the
        pipeline opens, without having to pick a filter first. Each opportunity
        action therefore opens with the "Include Archived" facet already set
        (the filter lives in view_crm_lead_search_bdr, crm_lead_views.xml).
        It is a plain search facet: removing it from the search bar gives the
        stock active-only view back, and saved favourites still override it.

        Done as a search default rather than active_test=False in the context,
        because active_test would leak into every relational dropdown opened
        from these views (archived stages, partners, teams...).

        The context field replaces the whole dict, so each record repeats the
        keys core (and sale_crm, for crm_lead_opportunities) sets today plus
        search_default_include_archived. Keep them in step with core on upgrade.
    -->

    <!-- CRM > My Pipeline (opened through the crm.action_your_pipeline server
         action, which reads this record's context and adds default_team_id). -->
    <record id="crm.crm_lead_action_pipeline" model="ir.actions.act_window">
        <field name="context">{
            'default_type': 'opportunity',
            'search_default_assigned_to_me': 1,
            'show_user_team_stages': 1,
            'search_default_include_archived': 1,
        }</field>
    </record>

    <!-- Generic "Opportunities" action (campaign / lead-mining stat buttons and
         other code paths that open the opportunity list). Context as set by
         sale_crm, which this module depends on. -->
    <record id="crm.crm_lead_opportunities" model="ir.actions.act_window">
        <field name="context">{
            'default_type': 'opportunity',
            'default_user_id': uid,
            'search_default_include_archived': 1,
        }</field>
    </record>

    <!-- CRM > Teams > "Pipeline" link on a team card. -->
    <record id="crm.crm_case_form_view_salesteams_opportunity" model="ir.actions.act_window">
        <field name="context">{
            'search_default_team_id': [active_id],
            'default_team_id': active_id,
            'default_type': 'opportunity',
            'default_user_id': uid,
            'search_default_include_archived': 1,
        }</field>
    </record>

</odoo>
