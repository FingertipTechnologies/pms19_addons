<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_technical_lead" model="ir.ui.view">
        <field name="name">project.project.form.technical.lead</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="technical_lead_id" widget="many2one_avatar_user"
                       readonly="not active" domain="[('share', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
