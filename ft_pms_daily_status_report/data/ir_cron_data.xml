<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily, at the main company's "Daily Report Send Time" (company
             time zone): nextcall is aligned by res.company.write and by the
             install hook, the cron then adds one day per run. -->
        <record id="ir_cron_send_daily_reports" model="ir.cron">
            <field name="name">PMS: Send Daily Implementation and AMC Reports</field>
            <field name="model_id" ref="model_ft_pms_daily_report"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_daily_reports()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 02:30:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
