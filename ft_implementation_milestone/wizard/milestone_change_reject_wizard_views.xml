<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ft_milestone_change_reject_wizard_form" model="ir.ui.view">
        <field name="name">ft.milestone.change.reject.wizard.form</field>
        <field name="model">ft.milestone.change.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Milestone Change">
                <field name="request_id" invisible="1"/>
                <group>
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="Why is this change refused?"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
