<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One row per milestone, edited in place: the list IS the set of
         milestones a new Implementation project starts with. Drag to
         reorder; archive to stop adding one. -->
    <record id="view_ft_milestone_template_list" model="ir.ui.view">
        <field name="name">ft.milestone.template.list</field>
        <field name="model">ft.milestone.template</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="sequence, id">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stage_key" optional="show"/>
                <field name="description" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ft_milestone_template_form" model="ir.ui.view">
        <field name="name">ft.milestone.template.form</field>
        <field name="model">ft.milestone.template</field>
        <field name="arch" type="xml">
            <form string="Milestone Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. BRD Approval"/></h1>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="sequence"/>
                        <field name="stage_key"/>
                        <field name="description" placeholder="Copied onto the project milestone"/>
                    </group>
                    <div class="text-muted small">
                        Every active template is added to a new Implementation project as a
                        milestone with 0% and no due date. The Project Manager enters the
                        agreed percentages in the project's Milestones tab during KICKOFF;
                        they must add up to 100% before the project moves to DISC. The
                        Delivery Stage is for information only.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ft_milestone_template_search" model="ir.ui.view">
        <field name="name">ft.milestone.template.search</field>
        <field name="model">ft.milestone.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="stage_key"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ft_milestone_template" model="ir.actions.act_window">
        <field name="name">Milestone Templates</field>
        <field name="res_model">ft.milestone.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a milestone template</p>
            <p>The milestones (Advance, BRD Approval, delivery milestones ...) every
               new Implementation project starts with, at 0%. The percentages are
               agreed per project during KICKOFF.</p>
        </field>
    </record>

    <!-- Under the Milestones root of project_custom_milestone, beside
         Project Milestones (10). Administrators / project managers only: a
         template is configuration. -->
    <menuitem id="menu_ft_milestone_template"
              name="Milestone Templates"
              parent="project_custom_milestone.menu_project_custom_milestone_root"
              action="action_ft_milestone_template"
              groups="project.group_project_manager,base.group_system"
              sequence="30"/>

</odoo>
