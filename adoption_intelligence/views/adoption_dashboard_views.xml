<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One OWL client action; `params.tab` selects the screen, so every menu opens the same app. -->
    <record id="action_adoption_overview" model="ir.actions.client">
        <field name="name">Adoption Overview</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'overview'}"/>
    </record>
    <record id="action_adoption_leaderboard" model="ir.actions.client">
        <field name="name">Adoption Leaderboard</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'leaderboard'}"/>
    </record>
    <record id="action_adoption_user_adoption" model="ir.actions.client">
        <field name="name">User Adoption</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'user'}"/>
    </record>
    <record id="action_adoption_field_adoption" model="ir.actions.client">
        <field name="name">Field Adoption</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'fields'}"/>
    </record>
    <record id="action_adoption_navigation" model="ir.actions.client">
        <field name="name">Navigation</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'navigation'}"/>
    </record>
    <record id="action_adoption_activity" model="ir.actions.client">
        <field name="name">Activity Log</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'activity'}"/>
    </record>
    <record id="action_adoption_models" model="ir.actions.client">
        <field name="name">Model Analytics</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'models'}"/>
    </record>
    <record id="action_adoption_reports" model="ir.actions.client">
        <field name="name">Reports</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'reports'}"/>
    </record>
    <record id="action_adoption_health" model="ir.actions.client">
        <field name="name">Health and Errors</field>
        <field name="tag">adoption_intelligence.dashboard</field>
        <field name="params" eval="{'tab': 'health'}"/>
    </record>
</odoo>
