            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='project_id']" position="after">
                    <field name="project_status" optional="show" string="Project Stage"/>
                </xpath>
                <xpath expr="//field[@name='task_id']" position="after">
                    <field name="module_id"/>
                    <field name="used_ai" column_invisible="1"/>
                    <field name="ai_time_impact"/>
                    <field name="chat_link" column_invisible="1"/>
                    <field name="reason" column_invisible="1"/>
                    <field name="hours_saved" column_invisible="1"/>
                    <field name="challenges" column_invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='task_id']" position="attributes">
                    <attribute name="options">
                        {'no_create': True, 'no_create_edit': True}
                    </attribute>
                    <!-- Required whenever a project is set, which is what makes
                         the line a timesheet. Conditional rather than flat, so
                         an analytic line with no project stays valid. -->
                    <attribute name="required">project_id</attribute>
                </xpath>
                <xpath expr="//field[@name='so_line']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
            </field>
        </record>
