        <!-- Override hr_timesheet "Today" filter to use server's current date explicitly
             (independent of user's personal timezone preference). -->
        <record id="view_hr_timesheet_line_search_inherit_today" model="ir.ui.view">
            <field name="name">hr.timesheet.line.search.today.inherit</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='date_today']" position="attributes">
                    <attribute name="domain">[('date', '=', datetime.date.today().strftime('%Y-%m-%d'))]</attribute>
                </xpath>
                <!-- Business weeks are fixed at Sunday through Saturday.
                     Odoo's client domain evaluator supports relativedelta but
                     its date object does not expose Python's weekday method. -->
                <xpath expr="//filter[@name='date_this_week']" position="attributes">
                    <attribute name="domain">[
                        ('date', '&gt;=', (context_today() + relativedelta(days=-6, weekday=6)).strftime('%Y-%m-%d')),
                        ('date', '&lt;', (context_today() + relativedelta(days=1, weekday=6)).strftime('%Y-%m-%d')),
                    ]</attribute>
                </xpath>
                <xpath expr="//filter[@name='date_last_week']" position="attributes">
                    <attribute name="domain">[
                        ('date', '&gt;=', (context_today() + relativedelta(days=-13, weekday=6)).strftime('%Y-%m-%d')),
                        ('date', '&lt;', (context_today() + relativedelta(days=-6, weekday=6)).strftime('%Y-%m-%d')),
                    ]</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_timesheet.timesheet_action_all" model="ir.actions.act_window">
            <field name="name">All Timesheets</field>
            <field name="res_model">account.analytic.line</field>
            <field name="path">all-timesheets</field>
            <field name="search_view_id" ref="hr_timesheet.hr_timesheet_line_search"/>
            <field name="domain">[('project_id', '!=', False)]</field>
            <field name="context">{
                'is_timesheet': 1,
            }</field>
        </record>

        <record id="view_hr_timesheet_line_tree_inherit" model="ir.ui.view">
            <field name="name">hr.timesheet.line.tree.inherit</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="hr_timesheet.timesheet_view_tree_user"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='task_id']" position="attributes">
                    <attribute name="options">
                        {'no_create': True, 'no_create_edit': True}
                    </attribute>
                    <!-- Required whenever a project is set, which is what makes
                         the line a timesheet. Conditional rather than flat, so
                         an analytic line with no project stays valid. -->
                    <attribute name="required">project_id</attribute>
                </xpath>
                <xpath expr="//field[@name='so_line']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
            </field>
        </record>


        <record id="view_timesheet_tree_grouped" model="ir.ui.view">
            <field name="name">account.analytic.line.tree.grouped</field>
            <field name="model">account.analytic.line</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <!-- default_group_by takes ONE field. The web client passes the
                     attribute straight through as a single groupby, so a comma
                     separated value ("task_id,employee_id") reaches the server
                     verbatim and every timesheet list raises
                     "Invalid aggregate/groupby specification". -->
                <list string="Timesheets" default_group_by="task_id">
                    <field name="project_id" invisible="1"/>
                    <field name="project_status" optional="show" string="Project Stage"/>
                    <field name="task_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="module_id"/>
                    <field name="used_ai" column_invisible="1"/>
                    <field name="ai_time_impact"/>
                    <field name="chat_link" column_invisible="1"/>
                    <field name="reason" column_invisible="1"/>
                    <field name="hours_saved" column_invisible="1"/>
                    <field name="challenges" column_invisible="1"/>
                    <field name="jobposition_id" column_invisible="1"/>
                    <field name="employee_id"/>
                    <field name="date"/>
                    <field name="name"/>
                    <field name="unit_amount" sum="Total Time" string="Time Spent" widget="timesheet_uom"/>
                </list>
            </field>
        </record>
