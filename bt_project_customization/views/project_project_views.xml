        <record id="view_project_form_modules_tab" model="ir.ui.view">
        <field name="name">project.project.form.modules</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Modules" name="project_modules">
                    <field name="module_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name" string="Module Name" width="50%"/>
                            <field name="complete_date" string="Completion Date" width="50%" class="text-start"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

        <!-- Task point 12: Overdue status on the Project Kanban card. A red
             badge under the title, its tooltip carrying the exact milestone(s)
             the project is behind. -->
        <record id="view_project_kanban_inherit_overdue" model="ir.ui.view">
            <field name="name">project.project.kanban.inherit.overdue</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project_kanban"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='privacy_visibility']" position="after">
                    <field name="ft_is_overdue"/>
                    <field name="ft_overdue_reason"/>
                </xpath>
                <xpath expr="//div[hasclass('o_project_kanban_body')]" position="before">
                    <div t-if="record.ft_is_overdue.raw_value" class="mt-1">
                        <span class="badge text-bg-danger"
                              t-att-title="record.ft_overdue_reason.value">
                            <i class="fa fa-exclamation-triangle me-1" role="img"
                               aria-label="Overdue"/>Overdue
                        </span>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- Task point 12: Overdue in the Projects list. The row turns red and
             a hidden-by-default column exposes the reason. -->
        <record id="view_project_list_inherit_overdue" model="ir.ui.view">
            <field name="name">project.project.list.inherit.overdue</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-danger">ft_is_overdue</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="ft_is_overdue" column_invisible="1"/>
                    <field name="ft_overdue_reason" optional="hide"/>
                </xpath>
            </field>
        </record>

