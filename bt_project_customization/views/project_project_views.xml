        <!-- Project Type on the Projects search: one filter per type and a
             Group By, so the three kinds of engagement can be told apart in
             every list, kanban and pivot without falling back on reading the
             project name. Placed on the core search view rather than a new
             action, because all four project actions share it. -->
        <record id="view_project_project_filter_inherit_type" model="ir.ui.view">
            <field name="name">project.project.select.inherit.project.type</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.view_project_project_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='stage_id']" position="after">
                    <field name="ft_project_type"/>
                </xpath>
                <xpath expr="//filter[@name='unassigned_projects']" position="after">
                    <separator/>
                    <filter string="Implementation" name="type_implementation"
                            domain="[('ft_project_type', '=', 'implementation')]"/>
                    <filter string="AMC" name="type_amc"
                            domain="[('ft_project_type', '=', 'amc')]"/>
                    <filter string="General" name="type_general"
                            domain="[('ft_project_type', '=', 'general')]"/>
                    <separator/>
                    <!-- Task point 12: surface behind-schedule projects. Backed
                         by project.project._search_ft_is_overdue. -->
                    <filter string="Overdue" name="filter_overdue"
                            domain="[('ft_is_overdue', '=', True)]"/>
                </xpath>
                <xpath expr="//filter[@name='groupby_stage']" position="before">
                    <filter string="Project Type" name="groupby_project_type"
                            context="{'group_by': 'ft_project_type'}"/>
                </xpath>
            </field>
        </record>

        <!-- Project Type on the two creation dialogs.

             The Projects kanban does not open the full project form to create:
             its "New" button runs project.open_create_project, which pops
             project_project_view_form_simplified (Name + email alias only), and
             creating inside a kanban column uses quick_create_project_form
             (Name only). Neither carries Project Type, so with the field's
             default removed both dialogs would fail the save on a required
             field the user cannot see. Adding it here is what makes "choose the
             type when you create the project" true on every path, not just on
             the full form.

             Inheriting the simplified view covers the footer variant too:
             project_project_view_form_simplified_footer is a primary view built
             on this one, so the field arrives there with the Create/Discard
             buttons already attached. -->
        <record id="project_project_view_form_simplified_inherit_type" model="ir.ui.view">
            <field name="name">project.project.view.form.simplified.inherit.project.type</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='alias_def']" position="before">
                    <group>
                        <!-- ft_project_type_create is the plain selection
                             widget plus one behaviour: choosing Implementation
                             closes this dialog and opens the full project form
                             with the name and type carried over. Implementation
                             is held to every date in the Dates section at
                             creation (_ft_check_creation_dates) and this dialog
                             shows none of them, so letting it try to save could
                             only ever end in "Every date in the Dates section
                             is required" against a form with no Dates section.
                             AMC and General stay here: General has no date
                             rule, and AMC's two are right below. -->
                        <field name="ft_project_type" widget="ft_project_type_create"/>
                        <!-- The two dates AMC must have to be created, shown
                             only for AMC. Implementation never sees them here
                             (it has already left for the full form), and
                             General is exempt from the rule. Same labels as
                             the full form; End Date must be on or after Start
                             Date, which core enforces. -->
                        <field name="date_start" string="Start Date"
                               invisible="ft_project_type != 'amc'"
                               required="ft_project_type == 'amc'"/>
                        <field name="date" string="End Date"
                               invisible="ft_project_type != 'amc'"
                               required="ft_project_type == 'amc'"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="quick_create_project_form_inherit_type" model="ir.ui.view">
            <field name="name">project.form.quick_create.inherit.project.type</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.quick_create_project_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <!-- Same behaviour as the Create a Project dialog above:
                         Implementation leaves for the full form, AMC gets its
                         two dates, General needs nothing more than a name. -->
                    <field name="ft_project_type" widget="ft_project_type_create"/>
                    <field name="date_start" string="Start Date"
                           invisible="ft_project_type != 'amc'"
                           required="ft_project_type == 'amc'"/>
                    <field name="date" string="End Date"
                           invisible="ft_project_type != 'amc'"
                           required="ft_project_type == 'amc'"/>
                </xpath>
            </field>
        </record>

        <record id="view_project_form_inherit_timesheet_button" model="ir.ui.view">
            <field name="name">project.project.form.inherit.timesheet.button</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_timesheets"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-clock-o">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <!-- Use float_time widget for proper time display -->
                                <field name="timesheet_count" widget="float_time"
                                       options="{'display_format': 'hh:mm'}"/>
                            </span>
                            <span class="o_stat_text">Hours Spent</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="view_project_form_inherit_custom" model="ir.ui.view">
            <field name="name">project.project.form.inherit.custom.fields</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">


                <xpath expr="//field[@name='tag_ids']" position="after">

                    <field name="ft_project_type"/>
                    <!--                    <field name="account_id"/>-->
                    <field name="architect_id"/>
                    <field name="ba_id"/>
                    <field name="pm_id"/>
                    <!-- What the Module field on this project's tasks may
                         offer. Editing it here writes the same rows as the
                         Projects field on the module itself. -->
                    <field name="module_ids" widget="many2many_tags"
                           options="{'no_quick_create': True}" invisible="1"/>
<!--                    <field name="status"/>-->
                    <!--                    <field name="finance_description"/>-->


                </xpath>

                <xpath expr="//field[@name='user_id']" position="after">

                    <field name="allow_billable"/>
                    <field name="partner_id" invisible="not allow_billable" widget="res_partner_many2one" context="{'res_partner_search_mode': 'customer'}"/>
                    <field name="brd_approval_date"/>
                    <field name="brd_submission_date"/>
                    <!-- go_live_date / ft_regression_date / ft_training_date are
                         shown in the DATES block (ft_dates group) via
                         ft_project_lifecycle; removed here to avoid duplicate
                         fields on the form. -->
                    <field name="kick_start_meeting_date"/>
                    <field name="sandbox_review_date"/>

                    <!--                    <field name="start_date"/>-->
                    <field name="support_start_date"/>
                    <field name="uat_start_date"/>

                    <field name="warranty_end_date"/>
                    <!-- Overdue indicator (task point 12): the boolean drives the
                         danger styling, the reason spells out which milestone is
                         behind. Both stay hidden until the project is overdue. -->
                    <field name="ft_is_overdue" invisible="1"/>
                    <field name="ft_overdue_reason" invisible="not ft_is_overdue"
                           readonly="1" class="text-danger fw-bold"/>


                </xpath>

                <xpath expr="//page[@name='description']" position="before">
                    <!-- On-Time Delivery. The counts sit next to the percentage on
                         purpose: the percentage alone hides both of its blind
                         spots. "Delivered Without Deadline" shows how much work
                         the percentage ignored, and "Open & Overdue" shows the
                         late work that never finished and so never counted. -->
                    <page name="delivery" string="Delivery">
                        <group>
                            <group string="On-Time Delivery">
                                <!-- No widget="percentage": that formatter does
                                     value*100 and expects a 0-1 fraction, which
                                     would render 95 as 9500%. The value is
                                     already 0-100 and the label carries the %. -->
                                <field name="ft_on_time_rate" digits="[5, 1]"/>
                                <field name="ft_delivered_tasks"/>
                                <field name="ft_on_time_tasks"/>
                                <field name="ft_late_tasks"/>
                            </group>
                            <group string="Blind Spots">
                                <field name="ft_no_deadline_tasks"/>
                                <field name="ft_overdue_open_tasks"/>
                                <field name="ft_unestimated_tasks"/>
                            </group>
                            <group string="Delivery Efficiency">
                                <!-- Target 90-110%. Same no-percentage-widget
                                     reasoning as the on-time rate above. -->
                                <field name="ft_efficiency_rate" digits="[5, 1]"/>
                                <field name="ft_estimated_hours" widget="float_time"/>
                                <field name="ft_actual_hours" widget="float_time"/>
                            </group>
                            <group string="Rework">
                                <!-- Two measures on purpose: how OFTEN work
                                     comes back, and how much it COSTS. Target
                                     10% or below on the count rate. -->
                                <field name="ft_rework_rate" digits="[5, 1]"/>
                                <field name="ft_reworked_tasks"/>
                                <field name="ft_rework_hours" widget="float_time"/>
                                <field name="ft_rework_hours_rate" digits="[5, 1]"/>
                            </group>
                        </group>
                    </page>
                    <page name="extra_info" string="Extra Information">
                        <!--                        <field name="description"/>-->
                        <group>
                            <group>
                            <field name="payment_terms_id"/>
                            <field name="user_name"/>
                            <field name="password"/>
                            <field name="poc_email"/>
                            <field name="poc_mobile"/>
                            <field name="short_code"/>
                            <field name="comments"/>
                            <field name="development"/>
                        </group>
                        <group>
                            <field name="hourly_billing_rate"/>
                            <field name="hourly_cost"/>
                            <field name="hours_balance"/>
                            <field name="hours_est_pm"/>
                            <field name="hours_est_qa"/>
                            <field name="hours_est_dev"/>
                            <field name="hours_overflowed"/>
                            <field name="stories"/>

                        </group>

                        </group>


                    </page>
                </xpath>
            </field>
        </record>

