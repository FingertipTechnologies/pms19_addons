<odoo>
    <record id="view_task_form_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit.custom.fields</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="task_type"/>
                <!-- The project's type, for the Task Source requirements
                     below. Invisible: it is shown on the project, not on
                     every one of its tasks. -->
                <field name="ft_project_type" invisible="1"/>
                <field name="source_ticket_id"
                       invisible="task_source not in ['change_request', 'enhancement']"
                       required="task_source in ['change_request', 'enhancement'] and ft_project_type == 'implementation'"
                       domain="[('project_id', '=', project_id), ('channel', '=', 'portal')]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <!-- Required: a task with no estimate cannot be measured by
                     Delivery Efficiency and lands in Not Estimated. -->
                <field name="estimated" widget="float_time" required="project_id"/>
                <field name="actual"/>
                <field name="ft_allowed_module_ids" invisible="1"/>
                <field name="module_id" required="True"
                       domain="[('id', 'in', ft_allowed_module_ids)]"/>
                <field name="ft_work_end_date"/>
                <field name="ft_completed_by_id" widget="many2one_avatar_user"/>
                <field name="date_end" string="Completed Date" readonly="1"/>
            </field>
            <!-- Deadline is a core field, so it is marked required here rather
                 than redeclared. Without one a task can never be judged on time
                 or late: it is excluded from On-Time Delivery and counted as
                 Delivered Without Deadline. -->
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <!-- Keep the long Text field in the wider left-hand details group;
                 the nested custom group on the right compresses Text widgets. -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <!-- Required on a NEW task only (`not id`), matching
                     _check_task_source_required, which create() calls and
                     write() does not. The backlog predates this field, so most
                     of it has no source; demanding one before an old task
                     could be edited at all blocked reclassifying, reassigning
                     or completing it over a rule that did not exist when it
                     was raised.

                     Every project type. The CONDITIONAL rules below (a
                     ticket for a Change Request, a reason for Unplanned) stay
                     Implementation's, because they read a delivery timeline
                     AMC and General do not have — but being asked to say where
                     the work came from does not depend on that, and AMC is
                     precisely the type _ft_task_source cannot fill in
                     automatically. -->
                <field name="task_source"
                       required="not id and task_type == 'user_story'"/>
                <field name="unplanned_reason"
                       invisible="task_source != 'unplanned'"
                       required="task_source == 'unplanned' and ft_project_type == 'implementation'"
                       placeholder="Explain why this task was unplanned (minimum 20 characters)…"/>
                <field name="ft_timeline_status"/>
                <field name="ft_worked_by_id" widget="many2one_avatar_user"/>
                <field name="ft_work_start_date"/>
                <field name="ft_deadline_change_count"/>
                <!-- Rework audit stays on the left with the work-start audit. -->
                <field name="ft_reopen_count" invisible="ft_reopen_count == 0"/>
                <field name="ft_rework_hours" widget="float_time"
                       invisible="ft_reopen_count == 0"/>
                <field name="ft_reopened_date" readonly="1"
                       invisible="ft_reopen_count == 0"/>
            </xpath>
        </field>
    </record>
 
    <!-- Add module_id to quick create form -->
    <record id="view_quick_create_task_module" model="ir.ui.view">
        <field name="name">project.task.quick_create.module</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.quick_create_task_form"/>
        <field name="arch" type="xml">
            <field name="user_ids" position="before">
                <field name="ft_allowed_module_ids" invisible="1"/>
                <field name="module_id" required="True"
                       domain="[('id', 'in', ft_allowed_module_ids)]"/>
                <field name="ft_project_type" invisible="1"/>
                <!-- Always: this view only ever creates, and a quick-created
                     task takes the User Story default that the rule keys on. -->
                <field name="task_source" required="True"/>
                <field name="source_ticket_id"
                       invisible="task_source not in ['change_request', 'enhancement']"
                       required="task_source in ['change_request', 'enhancement'] and ft_project_type == 'implementation'"
                       domain="[('project_id', '=', project_id), ('channel', '=', 'portal')]"
                       options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="unplanned_reason"
                       invisible="task_source != 'unplanned'"
                       required="task_source == 'unplanned' and ft_project_type == 'implementation'"
                       colspan="2" class="w-100"
                       placeholder="Minimum 20 characters…"/>
                <!-- Both are required by a server constraint, so quick-create
                     has to offer them or every quick-created task would be
                     rejected on save with no way to satisfy it from here.
                     Quick create always runs inside a project, so the estimate
                     is unconditionally required here. -->
                <field name="estimated" widget="float_time" required="1"/>
                <field name="date_deadline" required="1"/>
            </field>
        </field>
    </record>

     <record id="view_task_kanban_module_field" model="ir.ui.view">
        <field name="name">project.task.kanban.module.field</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="module_id"/>
            </xpath>
        </field>
    </record>

    <!-- Drop the Progress column from the All Tasks list.

         Progress is hr_timesheet's, computed as time spent / allocated hours, so
         it only ever shows a value on tasks that have Estimated (allocated)
         hours set. With Estimated at 00:00 the column is permanently blank and
         its average permanently 0%, so it just costs width.

         Targets the progressbar column specifically: the same view also carries a
         column_invisible copy of `progress` that the Time Remaining decorations
         read, and removing that one would break them. column_invisible keeps the
         field loaded while taking the column out of the list and out of the
         optional-columns dropdown. -->
    <record id="view_task_tree_hide_progress" model="ir.ui.view">
        <field name="name">project.task.list.hide.progress</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_tree2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='progress'][@widget='project_task_progressbar']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide the task state selection (In Progress / Changes Requested /
         Approved / Cancelled / Done) on the task form. The stage bar
         (Planned / Working / Testing / ...) is what we track tasks by.

         The containers are hidden rather than the field removed: the field
         stays loaded, so state keeps computing and every other view and module
         that reads it is untouched. Kanban and list still show the widget, so
         tasks can still be closed — stages do not set state in Odoo 18, and
         reporting on '1_done' would break if nothing could. -->
    <record id="view_task_form_hide_state" model="ir.ui.view">
        <field name="name">project.task.form.hide.state.widget</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Stock renders the widget twice: [1] for active tasks,
                 [2] for archived ones. -->
            <xpath expr="//div[hasclass('o_state_container')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[field[@name='priority']]/field[@name='state'][@widget='project_task_state_selection']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Module as a column in the Tasks list.
         Separate from the search entry below, because the two appear in
         different menus and people look for "Module" in both: this one puts it
         in the column picker (the toggle at the right of the header row),
         while the search view below puts it in the Filters / Group By dropdown
         next to the search box. optional="show" so it is visible straight away;
         it can be switched off per user from the same picker. -->
    <record id="view_task_list_module_column" model="ir.ui.view">
        <field name="name">project.task.list.module.column</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_main_base"/>
        <field name="arch" type="xml">
            <field name="project_id" position="after">
                <field name="module_id" string="Module" optional="show"/>
                <field name="task_type"
                   string="Task Type"
                   optional="show"/>

                <field name="task_source"
                    string="Task Source"
                    optional="show"/>

                <field name="ft_timeline_status"
                   string="Timeline Status"
                   widget="badge"
                   decoration-success="ft_timeline_status == 'on_time'"
                   decoration-danger="ft_timeline_status == 'overdue'"
                   optional="show"/>

                <field name="ft_worked_by_id"
                    string="Worked By"
                    widget="many2one_avatar_user"
                    optional="show"/>

                <field name="ft_completed_by_id"
                    string="Completed By"
                    widget="many2one_avatar_user"
                    optional="show"/>
            </field>
        </field>
    </record>

    <!-- Module in the Tasks search panel.
         project.task.module_id is declared by this module (models/project_task.py),
         so its search entry belongs here rather than in whichever module happens
         to render the list.

         project.view_task_search_form is the search view the All Tasks action
         actually loads (action_view_all_task -> search_view_id), so extending it
         is what puts Module in front of the user on that page.

         Two additions, because "filter" means both things in the UI: the <field>
         makes a typed module name match tasks from the search box, and the
         Group By entry lets the list be broken down by module the way it already
         can be by Stage. Anchored on the Stage entries, which come from
         view_task_search_form_base and are present in the resolved arch. -->
    <record id="view_task_search_module" model="ir.ui.view">
        <field name="name">project.task.search.module</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <field name="stage_id" position="after">
                <field name="module_id" string="Module"/>
            </field>
            <filter name="stage" position="after">
                <filter string="Module" name="groupby_module"
                        context="{'group_by': 'module_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
