<odoo>
    <record id="ft_task_reopen_wizard_view_form" model="ir.ui.view">
        <field name="name">ft.task.reopen.wizard.form</field>
        <field name="model">ft.task.reopen.wizard</field>
        <field name="arch" type="xml">
            <form string="Reopen for Rework">
                <p class="text-muted">
                    The task returns to Working. Set the new deadline for the
                    rework; it must be in the future (and at least 24 hours
                    away for a User Story).
                </p>
                <group>
                    <field name="task_id"/>
                    <field name="current_deadline"/>
                    <field name="new_deadline"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
