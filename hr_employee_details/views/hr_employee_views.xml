<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================= -->
    <!--  Standalone views for One2many models     -->
    <!-- ========================================= -->

    <record id="hr_employee_family_tree" model="ir.ui.view">
        <field name="name">hr.employee.family.tree</field>
        <field name="model">hr.employee.family</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" required="1"/>
                <field name="relation" required="1"/>
                <field name="date_of_birth" required="1" options="{'max_date': 'today'}"/>
                <field name="is_residing_with" required="1"/>
                <field name="place_of_residence" required="is_residing_with == 'no'"
                       invisible="is_residing_with != 'no'"/>
                <field name="state" options="{'no_create': True, 'no_open': True}" required="is_residing_with == 'no'"
                       invisible="is_residing_with != 'no'"/>
                <field name="district" required="is_residing_with == 'no'" invisible="is_residing_with != 'no'"/>
                <field name="phone" required="1"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_family_form" model="ir.ui.view">
        <field name="name">hr.employee.family.form</field>
        <field name="model">hr.employee.family</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="relation" required="1"/>
                            <field name="date_of_birth" required="1" options="{'max_date': 'today'}"/>
                            <field name="is_residing_with" required="1"/>
                        </group>
                        <group>
                            <field name="place_of_residence" required="is_residing_with == 'no'"
                                   invisible="is_residing_with != 'no'"/>
                            <field name="state" options="{'no_create': True, 'no_open': True}"
                                   required="is_residing_with == 'no'" invisible="is_residing_with != 'no'"/>
                            <field name="district" required="is_residing_with == 'no'"
                                   invisible="is_residing_with != 'no'"/>
                            <field name="phone" required="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_reference_tree" model="ir.ui.view">
        <field name="name">hr.employee.reference.tree</field>
        <field name="model">hr.employee.reference</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" required="1"/>
                <field name="address" required="1"/>
                <field name="mobile" required="1"/>
                <field name="email" required="1"/>
            </list>
        </field>
    </record>

    <record id="hr_employee_reference_form" model="ir.ui.view">
        <field name="name">hr.employee.reference.form</field>
        <field name="model">hr.employee.reference</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="address" required="1"/>
                        <field name="mobile" required="1"/>
                        <field name="email" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================= -->
    <!--  REPLACE entire Personal Information tab  -->
    <!-- ========================================= -->

    <record id="view_employee_form_inherit_details" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.details</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Replace the Personal Information page completely -->
            <xpath expr="//page[@name='personal_information']" position="replace">
                <page string="Personal" name="personal_information">

                    <!-- S.No 1-3: Document Numbers -->
                    <separator string="Document Numbers &amp; Copies"/>
                    <group>
                        <group>
                            <field name="aadhar_no"/>
                            <field name="pan_no"/>
                            <field name="uan_pf_no" placeholder="If you have one, enter it here"/>
                        </group>
                        <group>
                            <field name="aadhar_copy_filename" invisible="1"/>
                            <label for="aadhar_copy"/>
                            <div class="o_row">
                                <field name="aadhar_copy" nolabel="1" filename="aadhar_copy_filename"/>
                                <button name="action_view_aadhar_copy" type="object" string="View"
                                         icon="fa-eye" class="btn-link" groups="hr.group_hr_user"
                                         invisible="not aadhar_copy or not id"/>
                            </div>
                            <field name="pan_copy_filename" invisible="1"/>
                            <label for="pan_copy"/>
                            <div class="o_row">
                                <field name="pan_copy" nolabel="1" filename="pan_copy_filename"/>
                                <button name="action_view_pan_copy" type="object" string="View"
                                         icon="fa-eye" class="btn-link" groups="hr.group_hr_user"
                                         invisible="not pan_copy or not id"/>
                            </div>
                            <field name="bank_copy_filename" invisible="1"/>
                            <label for="bank_copy"/>
                            <div class="o_row">
                                <field name="bank_copy" nolabel="1" filename="bank_copy_filename"/>
                                <button name="action_view_bank_copy" type="object" string="View"
                                         icon="fa-eye" class="btn-link" groups="hr.group_hr_user"
                                         invisible="not bank_copy or not id"/>
                            </div>

                        </group>
                    </group>

                    <separator string="Basic Details"/>
                    <group>
                        <group>
                            <field name="father_name"/>
                            <field name="birthday" options="{'max_date': 'today'}"/>
                            <field name="sex"/>
                            <field name="marital"/>
                            <field name="date_of_joining"/>
                            <field name="job_title"/>
                        </group>
                    </group>

                    <!-- S.No 11: Present Address -->
                    <separator string="Present Address"/>
                    <group>
                        <group>
                            <field name="present_address"/>
                            <field name="present_state" options="{'no_create': True, 'no_open': True}"/>
                            <field name="present_district"/>
                            <field name="present_pin_code"/>
                        </group>
                        <group>
                            <field name="present_mobile"/>
                            <field name="present_email"/>
                            <field name="emergency_contact_no" placeholder="Not same as Mobile No"/>
                        </group>
                    </group>


                    <!-- S.No 12: Permanent Address -->
                    <separator string="Permanent Address"/>
                    <group>
                        <group>
                            <field name="permanent_same_as_present"/>
                            <field name="permanent_address" readonly="permanent_same_as_present"
                                   force_save="1"/>
                            <field name="permanent_state" readonly="permanent_same_as_present"
                                   force_save="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="permanent_district" readonly="permanent_same_as_present"
                                   force_save="1"/>
                            <field name="permanent_pin_code" readonly="permanent_same_as_present"
                                   force_save="1"/>
                        </group>
                        <group>
                            <field name="permanent_phone"/>
                            <field name="permanent_mobile" readonly="permanent_same_as_present"
                                   force_save="1"/>
                            <field name="permanent_email" readonly="permanent_same_as_present"
                                   force_save="1"/>
                        </group>
                    </group>

                    <!-- S.No 13: Family Particulars -->
                    <separator string="Family Particulars"/>
                    <field name="family_ids" widget="one2many"/>

                    <!-- S.No 14: Bank Account Details -->
                    <separator string="Bank Account Details"/>
                    <group>
                        <group>
                            <field name="bank_account_number"/>
                            <field name="bank_account_type"/>
                            <field name="bank_name"/>
                        </group>
                        <group>
                            <field name="bank_branch"/>
                            <field name="bank_ifsc"/>
                            <field name="bank_micr" required="0"/>
                        </group>
                    </group>

                    <!-- S.No 15: References -->
                    <separator string="References (Friends &amp; Family)"/>
                    <field name="reference_ids" widget="one2many"/>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
