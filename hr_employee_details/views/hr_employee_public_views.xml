<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!--  Personal page on the PUBLIC employee profile                -->
    <!--  (what regular employees see in the Employees app).          -->
    <!--  Visible and editable only for:                              -->
    <!--    * the employee's own record (logged-in user)              -->
    <!--    * HR Officers / HR Administrators / Settings admins       -->
    <!--  The values themselves are also filtered server-side, so     -->
    <!--  other employees' data is never sent to the browser.         -->
    <!-- ============================================================ -->

    <record id="view_employee_public_form_inherit_details" model="ir.ui.view">
        <field name="name">hr.employee.public.form.inherit.details</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">

            <!-- Profile photo: editable on the employee's own record (and
                 for HR / administrators), read-only on anybody else's. The
                 model makes the field writable; this keeps the widget locked
                 where the server would refuse the write anyway. -->
            <xpath expr="//field[@name='image_1920']" position="attributes">
                <attribute name="readonly">not can_access_personal_details</attribute>
            </xpath>

            <xpath expr="//page[@name='work_information']" position="after">
                <page string="Personal" name="personal_information"
                      invisible="not can_access_personal_details">
                    <field name="can_access_personal_details" invisible="1"/>

                    <!-- S.No 1-3: Document Numbers -->
                    <separator string="Document Numbers &amp; Copies"/>
                    <group>
                        <group>
                            <field name="aadhar_no" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="pan_no" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="uan_pf_no" placeholder="If you have one, enter it here" readonly="not can_access_personal_details"/>
<!--                            <field name="father_name" required="can_access_personal_details" readonly="not can_access_personal_details"/>-->
<!--                            <field name="details_birthday" required="can_access_personal_details" readonly="not can_access_personal_details" options="{'max_date': 'today'}"/>-->
<!--                            <field name="details_marital" required="can_access_personal_details" readonly="not can_access_personal_details"/>-->
<!--                            <field name="date_of_joining" required="can_access_personal_details" readonly="not can_access_personal_details"/>-->
<!--                            <field name="details_job_title" required="can_access_personal_details" readonly="not can_access_personal_details"/>-->
                        </group>
                        <group>
                            <field name="aadhar_copy_filename" invisible="1"/>
                            <label for="aadhar_copy"/>
                            <div class="o_row">
                                <field name="aadhar_copy" nolabel="1" required="can_access_personal_details" readonly="not can_access_personal_details" filename="aadhar_copy_filename"/>
                                <button name="action_view_aadhar_copy" type="object" string="View"
                                        icon="fa-eye" class="btn-link" invisible="not aadhar_copy or not id"/>
                            </div>
                            <field name="pan_copy_filename" invisible="1"/>
                            <label for="pan_copy"/>
                            <div class="o_row">
                                <field name="pan_copy" nolabel="1" required="can_access_personal_details" readonly="not can_access_personal_details" filename="pan_copy_filename"/>
                                <button name="action_view_pan_copy" type="object" string="View"
                                        icon="fa-eye" class="btn-link" invisible="not pan_copy or not id"/>
                            </div>
                            <field name="bank_copy_filename" invisible="1"/>
                            <label for="bank_copy"/>
                            <div class="o_row">
                                <field name="bank_copy" nolabel="1" required="can_access_personal_details" readonly="not can_access_personal_details" filename="bank_copy_filename"/>
                                <button name="action_view_bank_copy" type="object" string="View"
                                        icon="fa-eye" class="btn-link" invisible="not bank_copy or not id"/>
                            </div>
                        </group>
                    </group>

                    <separator string="Basic Details"/>
                    <group>
                        <group>
<!--                            <field name="aadhar_no" required="can_access_personal_details" readonly="not can_access_personal_details"/>-->
<!--                            <field name="pan_no" required="can_access_personal_details" readonly="not can_access_personal_details"/>-->
<!--                            <field name="uan_pf_no" placeholder="If you have one, enter it here" readonly="not can_access_personal_details"/>-->
                            <field name="father_name" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="sex" required="can_access_personal_details" readonly="not can_access_personal_details" options="{'max_date': 'today'}"/>
                            <field name="details_birthday" required="can_access_personal_details" readonly="not can_access_personal_details" options="{'max_date': 'today'}"/>
                            <field name="details_job_title" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="is_trainee" invisible="1"/>
                            <field name="doj_training" string="Date of Joining (Training)" required="can_access_personal_details and is_trainee" readonly="not can_access_personal_details"/>
                            <field name="date_of_joining" string="Date of Joining (Payroll)" required="can_access_personal_details and not is_trainee" readonly="not can_access_personal_details"/>
                        </group>
                    </group>

                    <!-- S.No 11: Present Address -->
                    <separator string="Present Address"/>
                    <group>
                        <group>
                            <field name="present_address" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="present_state" required="can_access_personal_details" readonly="not can_access_personal_details" options="{'no_create': True, 'no_open': True}"/>
                            <field name="present_district" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="present_pin_code" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                        </group>
                        <group>
                            <field name="present_mobile" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="present_email" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="emergency_contact_no" placeholder="Not same as Mobile No" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                        </group>
                    </group>

                    <!-- S.No 12: Permanent Address -->
                    <separator string="Permanent Address"/>
                    <group>
                        <group>
                            <field name="permanent_same_as_present" readonly="not can_access_personal_details"/>
                            <field name="permanent_address" required="can_access_personal_details" readonly="not can_access_personal_details or permanent_same_as_present" force_save="1"/>
                            <field name="permanent_state" required="can_access_personal_details" readonly="not can_access_personal_details or permanent_same_as_present" force_save="1" options="{'no_create': True, 'no_open': True}"/>
                            <field name="permanent_district" required="can_access_personal_details" readonly="not can_access_personal_details or permanent_same_as_present" force_save="1"/>
                            <field name="permanent_pin_code" required="can_access_personal_details" readonly="not can_access_personal_details or permanent_same_as_present" force_save="1"/>
                        </group>
                        <group>
                            <field name="permanent_phone" readonly="not can_access_personal_details"/>
                            <field name="permanent_mobile" required="can_access_personal_details" readonly="not can_access_personal_details or permanent_same_as_present" force_save="1"/>
                            <field name="permanent_email" required="can_access_personal_details" readonly="not can_access_personal_details or permanent_same_as_present" force_save="1"/>
                        </group>
                    </group>

                    <!-- S.No 13: Family Particulars -->
                    <separator string="Family Particulars"/>
                    <field name="family_ids" widget="one2many" readonly="not can_access_personal_details"/>

                    <!-- S.No 14: Bank Account Details -->
                    <separator string="Bank Account Details"/>
                    <group>
                        <group>
                            <field name="bank_account_number" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="bank_account_type" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="bank_name" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                        </group>
                        <group>
                            <field name="bank_branch" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="bank_ifsc" required="can_access_personal_details" readonly="not can_access_personal_details"/>
                            <field name="bank_micr" readonly="not can_access_personal_details"/>
                        </group>
                    </group>

                    <!-- S.No 15: References -->
                    <separator string="References (Friends &amp; Family)"/>
                    <field name="reference_ids" widget="one2many" readonly="not can_access_personal_details"/>

                </page>
            </xpath>

        </field>
    </record>

</odoo>
