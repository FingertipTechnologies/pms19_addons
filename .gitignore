# Python bytecode — regenerated by the interpreter on every run, and the cause
# of most of the noise in `git status` on this repo.
__pycache__/
*.py[cod]
*$py.class

# Packaging / virtualenvs
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Odoo runtime output
*.log
*.pid
.odoorc
odoo.conf.local

# Front-end tooling, where a module ships one
node_modules/
.sass-cache/
*.css.map

# Editors and OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
