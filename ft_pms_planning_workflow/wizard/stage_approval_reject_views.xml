<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ft_pms_stage_approval_reject_wizard_form" model="ir.ui.view">
        <field name="name">ft.pms.stage.approval.reject.wizard.form</field>
        <field name="model">ft.pms.stage.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval Request">
                <field name="approval_ids" invisible="1"/>
                <group>
                    <field name="reason" placeholder="Why is this request rejected?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
