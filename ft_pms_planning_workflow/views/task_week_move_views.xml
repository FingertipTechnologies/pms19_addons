<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pwf_task_week_move_view_list" model="ir.ui.view">
        <field name="name">ft.pms.task.week.move.list</field>
        <field name="model">ft.pms.task.week.move</field>
        <field name="arch" type="xml">
            <list string="Deadline Changes" create="0" edit="0" delete="0">
                <field name="moved_on"/>
                <field name="task_id"/>
                <field name="project_id" optional="show"/>
                <field name="change_type"/>
                <field name="from_week_id"/>
                <field name="to_week_id"/>
                <field name="deadline_at_move" optional="show"/>
                <field name="new_deadline" optional="show"/>
                <field name="reason" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="pwf_task_week_move_view_form" model="ir.ui.view">
        <field name="name">ft.pms.task.week.move.form</field>
        <field name="model">ft.pms.task.week.move</field>
        <field name="arch" type="xml">
            <form string="Deadline Change" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="task_id"/>
                            <field name="project_id"/>
                            <field name="change_type"/>
                            <field name="from_week_id"/>
                            <field name="to_week_id"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="moved_on"/>
                            <field name="deadline_at_move"/>
                            <field name="new_deadline"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pwf_task_week_move_view_search" model="ir.ui.view">
        <field name="name">ft.pms.task.week.move.search</field>
        <field name="model">ft.pms.task.week.move</field>
        <field name="arch" type="xml">
            <search string="Deadline Changes">
                <field name="task_id"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <field name="to_week_id"/>
                <filter string="Week Moves" name="week_move" domain="[('change_type', '=', 'week_move')]"/>
                <filter string="Deadline Changes" name="deadline_change" domain="[('change_type', '=', 'deadline_change')]"/>
                <filter string="Reopened for Rework" name="reopen" domain="[('change_type', '=', 'reopen')]"/>
                <group>
                    <filter string="Change Type" name="group_change_type" context="{'group_by': 'change_type'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Changed By" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="To Week" name="group_to_week" context="{'group_by': 'to_week_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pwf_task_week_move_action" model="ir.actions.act_window">
        <field name="name">Task Deadline Changes</field>
        <field name="res_model">ft.pms.task.week.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pwf_task_week_move_view_search"/>
    </record>

    <!-- Task form: deadline tracking for ALL task types (original deadline,
         current deadline, change count and the change log: planner week
         moves, plain deadline changes and reopen-for-rework). -->
    <record id="pwf_view_task_form_week_moves" model="ir.ui.view">
        <field name="name">project.task.form.pwf.week.moves</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="pwf_week_moves" string="Deadline Tracking">
                    <group>
                        <group>
                            <field name="pwf_original_deadline" readonly="1"/>
                            <field name="date_deadline" string="Current Deadline"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="ft_deadline_change_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="pwf_week_move_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="moved_on" string="Changed On"/>
                            <field name="change_type"/>
                            <field name="deadline_at_move" string="Old Deadline"/>
                            <field name="new_deadline"/>
                            <field name="from_week_id" optional="show"/>
                            <field name="to_week_id" optional="show"/>
                            <field name="reason"/>
                            <field name="user_id" string="Changed By"
                                   widget="many2one_avatar_user"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
