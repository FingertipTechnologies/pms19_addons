<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Weekly timesheet approval (all project types).

         Weeks run Monday -> Sunday (ft_sprint_management week_utils).
         Who may approve is enforced in the backend
         (models/timesheet_approval.py): Administrator, PM / Team Lead job
         position, or the project's Project Manager - never one's own lines.
         ================================================================ -->

    <!-- Every timesheet list (and its primary children, e.g. All
         Timesheets / My Timesheets): approval badge + bulk buttons. -->
    <record id="hr_timesheet_line_tree_ft_approval" model="ir.ui.view">
        <field name="name">account.analytic.line.list.ft.approval</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/list/*[1]" position="before">
                <header>
                    <button name="action_ft_timesheet_approve" type="object"
                            string="Approve" class="btn-primary" groups="base.group_user"/>
                    <button name="action_ft_timesheet_reject" type="object"
                            string="Reject" groups="base.group_user"/>
                    <button name="action_ft_timesheet_reset" type="object"
                            string="Reset to Pending" groups="base.group_user"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='unit_amount']" position="after">
                <field name="ft_approval_state" string="Approval" widget="badge"
                       readonly="1" optional="show" groups="base.group_user"
                       decoration-info="ft_approval_state == 'pending'"
                       decoration-success="ft_approval_state == 'approved'"
                       decoration-danger="ft_approval_state == 'rejected'"/>
                <field name="ft_approved_by_id" readonly="1" optional="hide"
                       widget="many2one_avatar_user" groups="base.group_user"/>
            </xpath>
        </field>
    </record>

    <!-- Timesheet form: read-only review info. -->
    <record id="hr_timesheet_line_form_ft_approval" model="ir.ui.view">
        <field name="name">account.analytic.line.form.ft.approval</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Weekly Approval" name="ft_approval_section"
                       groups="base.group_user">
                    <group>
                        <field name="ft_approval_state" widget="badge" readonly="1"
                               decoration-info="ft_approval_state == 'pending'"
                               decoration-success="ft_approval_state == 'approved'"
                               decoration-danger="ft_approval_state == 'rejected'"/>
                        <field name="ft_week_label" readonly="1"/>
                        <field name="ft_rejection_reason" readonly="1"
                               invisible="ft_approval_state != 'rejected'"/>
                    </group>
                    <group>
                        <field name="ft_approved_by_id" readonly="1"
                               widget="many2one_avatar_user"
                               invisible="not ft_approved_by_id"/>
                        <field name="ft_approved_on" readonly="1"
                               invisible="not ft_approved_on"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Search: approval filters, Monday-to-Sunday week filters, group-bys.
         The stock "This Week" / "Last Week" filters follow the language's
         first day of week (Sunday-Saturday here); these use the stored
         Monday of each line instead. relativedelta(days=-6, weekday=0)
         lands on the Monday on/before today (days first, then the weekday
         jump - both in Python and in the web client's py_js). -->
    <record id="hr_timesheet_line_search_ft_approval" model="ir.ui.view">
        <field name="name">account.analytic.line.search.ft.approval</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='month']" position="after">
                <separator/>
                <filter string="Pending Approval" name="ft_approval_pending"
                        domain="[('ft_approval_state', '=', 'pending')]"/>
                <filter string="Approved" name="ft_approval_approved"
                        domain="[('ft_approval_state', '=', 'approved')]"/>
                <filter string="Rejected" name="ft_approval_rejected"
                        domain="[('ft_approval_state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Approval Week: This Week (Mon–Sun)" name="ft_week_this"
                        domain="[('ft_week_start', '=', (context_today() + relativedelta(days=-6, weekday=0)).strftime('%Y-%m-%d'))]"/>
                <filter string="Approval Week: Last Week (Mon–Sun)" name="ft_week_last"
                        domain="[('ft_week_start', '=', (context_today() + relativedelta(days=-13, weekday=0)).strftime('%Y-%m-%d'))]"/>
            </xpath>
            <xpath expr="//group[@name='groupby']" position="before">
                <field name="ft_approved_by_id"/>
            </xpath>
            <xpath expr="//group[@name='groupby']" position="inside">
                <!-- Grouped on the stored Monday by day: chronological and
                     independent of the language's first day of week. -->
                <filter string="Week (Mon–Sun)" name="groupby_ft_week"
                        context="{'group_by': 'ft_week_start:day'}"/>
                <filter string="Approval Status" name="groupby_ft_approval_state"
                        context="{'group_by': 'ft_approval_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- Dedicated review list (read-only rows, bulk buttons). -->
    <record id="view_ft_timesheet_approval_list" model="ir.ui.view">
        <field name="name">account.analytic.line.list.ft.timesheet.approval</field>
        <field name="model">account.analytic.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Timesheet Approvals" create="0" edit="0" delete="0"
                  default_order="date desc, id desc">
                <header>
                    <button name="action_ft_timesheet_approve" type="object"
                            string="Approve" class="btn-primary"/>
                    <button name="action_ft_timesheet_reject" type="object"
                            string="Reject"/>
                    <button name="action_ft_timesheet_reset" type="object"
                            string="Reset to Pending"/>
                </header>
                <field name="ft_week_label" string="Week (Mon–Sun)"/>
                <field name="date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="project_id"/>
                <field name="task_id" optional="show"/>
                <field name="name" optional="show"/>
                <field name="unit_amount" string="Time Spent" widget="timesheet_uom" sum="Total"/>
                <field name="ft_approval_state" string="Approval" widget="badge"
                       decoration-info="ft_approval_state == 'pending'"
                       decoration-success="ft_approval_state == 'approved'"
                       decoration-danger="ft_approval_state == 'rejected'"/>
                <field name="ft_approved_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="ft_approved_on" optional="hide"/>
                <field name="ft_rejection_reason" optional="hide"/>
                <field name="company_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_ft_timesheet_approval" model="ir.actions.act_window">
        <field name="name">Timesheet Approvals</field>
        <field name="res_model">account.analytic.line</field>
        <field name="path">timesheet-approvals</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_ft_timesheet_approval_list"/>
        <field name="search_view_id" ref="hr_timesheet.hr_timesheet_line_search"/>
        <field name="domain">[('project_id', '!=', False)]</field>
        <field name="context">{
            'search_default_ft_approval_pending': 1,
            'search_default_groupby_ft_week': 1,
            'search_default_groupby_employee': 2,
            'is_timesheet': 1,
            'create': 0,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No timesheets waiting for approval.
            </p>
            <p>
                Review your team's timesheets week by week (Monday to Sunday):
                select lines and Approve, or Reject with a reason.
            </p>
        </field>
    </record>

    <record id="action_ft_timesheet_approval_view_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_ft_timesheet_approval_list"/>
        <field name="act_window_id" ref="action_ft_timesheet_approval"/>
    </record>

    <record id="action_ft_timesheet_approval_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_timesheet.timesheet_view_form_user"/>
        <field name="act_window_id" ref="action_ft_timesheet_approval"/>
    </record>

    <!-- PMS > Timesheets > Timesheet Approvals. The Timesheets root
         (hr_timesheet.timesheet_menu_root) is reparented under PMS by
         qa_testapp. Shown to every internal user: approval rights are
         checked per line in the backend. -->
    <menuitem id="menu_ft_timesheet_approval"
              name="Timesheet Approvals"
              parent="hr_timesheet.timesheet_menu_root"
              action="action_ft_timesheet_approval"
              groups="base.group_user"
              sequence="7"/>

    <!-- Reject wizard (returned by action_ft_timesheet_reject). -->
    <record id="view_ft_timesheet_reject_wizard_form" model="ir.ui.view">
        <field name="name">ft.timesheet.reject.wizard.form</field>
        <field name="model">ft.timesheet.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Timesheets">
                <group>
                    <field name="reason" required="1"
                           placeholder="Why are these timesheets rejected?"/>
                </group>
                <field name="line_ids" readonly="1" nolabel="1">
                    <list create="0" edit="0" delete="0">
                        <field name="ft_week_label" string="Week (Mon–Sun)"/>
                        <field name="date"/>
                        <field name="employee_id"/>
                        <field name="project_id"/>
                        <field name="task_id"/>
                        <field name="name"/>
                        <field name="unit_amount" string="Time Spent" widget="float_time" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Reject"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Task form > Timesheets tab: approval badge per line. -->
    <record id="view_task_form_ft_timesheet_approval_tab" model="ir.ui.view">
        <field name="name">project.task.form.ft.timesheet.approval.tab</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_timesheets']//field[@name='timesheet_ids']/list" position="inside">
                <field name="ft_approval_state" string="Approval" widget="badge"
                       readonly="1" optional="show"
                       decoration-info="ft_approval_state == 'pending'"
                       decoration-success="ft_approval_state == 'approved'"
                       decoration-danger="ft_approval_state == 'rejected'"/>
            </xpath>
        </field>
    </record>

    <!-- Task form > Hours section (ft_task_hours_tracker, priority 99):
         approved / rejected / pending timesheet hours. Priority above 99 so
         the section already exists when this view is applied. -->
    <record id="view_task_form_ft_timesheet_approval_hours" model="ir.ui.view">
        <field name="name">project.task.form.ft.timesheet.approval.hours</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="priority">120</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='ft_hours_section']" position="inside">
                <field name="ft_approved_hours" widget="float_time" readonly="1"/>
                <field name="ft_rejected_hours" widget="float_time" readonly="1"/>
                <field name="ft_pending_hours" widget="float_time" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
