<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kanban quick create: a Testing task must live in a Week, so the Week
         is asked for on the card as soon as Testing is chosen. -->
    <record id="view_quick_create_task_pwf_week" model="ir.ui.view">
        <field name="name">project.task.quick_create.pwf.week</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="bt_project_customization.view_quick_create_task_module"/>
        <field name="arch" type="xml">
            <field name="date_deadline" position="after">
                <field name="sprint_id" string="Week"
                       invisible="task_type != 'testing'"
                       required="task_type == 'testing'"
                       placeholder="Select the week…"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
