<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_customer_feedback" model="res.groups.privilege">
        <field name="name">Customer Feedback</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <record id="group_feedback_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_customer_feedback"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_feedback_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_customer_feedback"/>
        <field name="implied_ids" eval="[(4, ref('group_feedback_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Portal users only ever see the responses of their own company. -->
    <record id="rule_feedback_response_portal" model="ir.rule">
        <field name="name">Feedback Response: portal sees own company</field>
        <field name="model_id" ref="model_ft_feedback_response"/>
        <field name="domain_force">[('commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_feedback_response_line_portal" model="ir.rule">
        <field name="name">Feedback Answer: portal sees own company</field>
        <field name="model_id" ref="model_ft_feedback_response_line"/>
        <field name="domain_force">[('response_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
