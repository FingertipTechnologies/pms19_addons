<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================= -->
    <!-- "Feedback" tab in the customer portal navigation  -->
    <!-- (both the landing page and the shared tab shell)  -->
    <!-- ================================================= -->
    <!-- Orange "Feedback" button (new form) beside Logout, and a "Feedbacks"
         tab (history) right after Knowledge Base, on both portal shells. -->
    <template id="portal_support_landing_feedback_tab"
            name="Feedback Button (landing)"
            inherit_id="ft_helpdesk_portal.portal_support_landing"
            priority="50">
        <xpath expr="//a[hasclass('ft-logout-btn')]" position="before">
            <a href="/my/feedback"
            class="btn ft-btn-orange text-nowrap px-4 py-2 me-2">
                <i class="fa fa-smile-o me-1"/> Feedback
            </a>
        </xpath>
        <xpath expr="//ul[hasclass('ft-support-tabs')]" position="inside">
            <li class="nav-item" role="presentation">
                <a class="nav-link" href="/my/feedbacks">
                    <i class="fa fa-comments-o me-1"/> Feedbacks
                </a>
            </li>
        </xpath>
    </template>

    <template id="portal_support_home_feedback_tab"
            name="Feedback Button (portal)"
            inherit_id="ft_helpdesk_portal.portal_support_home"
            priority="50">
        <xpath expr="//a[hasclass('ft-logout-btn')]" position="before">
            <a href="/my/feedback"
            class="btn ft-btn-orange text-nowrap px-4 py-2 me-2">
                <i class="fa fa-smile-o me-1"/> Feedback
            </a>
        </xpath>
        <xpath expr="//ul[hasclass('ft-support-tabs')]" position="inside">
            <li class="nav-item" role="presentation">
                <a t-attf-class="nav-link #{active_tab == 'feedbacks' and 'active' or ''}"
                   href="/my/feedbacks">
                    <i class="fa fa-comments-o me-1"/> Feedbacks
                </a>
            </li>
        </xpath>
    </template>

    <!-- ================================================= -->
    <!-- Smiley face (inline SVG), one per rating level    -->
    <!-- ================================================= -->
    <template id="feedback_smiley" name="Feedback Smiley">
        <svg viewBox="0 0 64 64" t-attf-class="ft-fb-smiley ft-fb-smiley-#{level}" aria-hidden="true">
            <circle cx="32" cy="32" r="30"/>
            <t t-if="level == 1">
                <!-- angry: slanted brows, deep frown -->
                <path class="ft-fb-brow" d="M17 22 L28 27"/>
                <path class="ft-fb-brow" d="M47 22 L36 27"/>
                <circle class="ft-fb-eye" cx="23" cy="31" r="3.5"/>
                <circle class="ft-fb-eye" cx="41" cy="31" r="3.5"/>
                <path class="ft-fb-mouth" d="M20 48 Q32 36 44 48"/>
            </t>
            <t t-if="level == 2">
                <circle class="ft-fb-eye" cx="23" cy="27" r="3.5"/>
                <circle class="ft-fb-eye" cx="41" cy="27" r="3.5"/>
                <path class="ft-fb-mouth" d="M21 46 Q32 39 43 46"/>
            </t>
            <t t-if="level == 3">
                <circle class="ft-fb-eye" cx="23" cy="27" r="3.5"/>
                <circle class="ft-fb-eye" cx="41" cy="27" r="3.5"/>
                <path class="ft-fb-mouth" d="M21 44 L43 44"/>
            </t>
            <t t-if="level == 4">
                <circle class="ft-fb-eye" cx="23" cy="27" r="3.5"/>
                <circle class="ft-fb-eye" cx="41" cy="27" r="3.5"/>
                <path class="ft-fb-mouth" d="M20 41 Q32 51 44 41"/>
            </t>
            <t t-if="level == 5">
                <circle class="ft-fb-eye" cx="23" cy="26" r="3.5"/>
                <circle class="ft-fb-eye" cx="41" cy="26" r="3.5"/>
                <path class="ft-fb-mouth ft-fb-mouth-open" d="M18 38 Q32 56 46 38 Z"/>
            </t>
        </svg>
    </template>

    <!-- ================================================= -->
    <!-- One question row (rating / score / text)          -->
    <!-- ================================================= -->
    <template id="feedback_question_row" name="Feedback Question Row">
        <t t-set="field_name" t-value="field_prefix + str(question.id)"/>
        <t t-set="current" t-value="answers.get(question.id)"/>
        <t t-set="error" t-value="errors.get(question.id)"/>
        <div t-attf-class="ft-fb-row row align-items-center gx-3 #{error and 'ft-fb-row-error' or ''}"
             t-att-id="'row_' + field_name">
            <div class="col-12 col-lg-5 ft-fb-question">
                <span t-out="question.name"/>
                <span t-if="question.required" class="text-danger ms-1" title="Required">*</span>
                <div t-if="error" class="ft-fb-error small mt-1">
                    <i class="fa fa-exclamation-circle me-1"/><t t-out="error"/>
                </div>
            </div>
            <div class="col-12 col-lg-7">

                <!-- Smiley rating 1..5 -->
                <div t-if="question.question_type == 'rating'" class="ft-fb-rating d-flex justify-content-between justify-content-lg-around">
                    <t t-foreach="rating_levels" t-as="level">
                        <label class="ft-fb-option text-center">
                            <input type="radio" t-att-name="field_name" t-att-value="level"
                                   t-att-checked="current == level and 'checked' or None"
                                   t-att-required="question.required and 'required' or None"/>
                            <t t-call="ft_customer_feedback.feedback_smiley"/>
                            <div class="ft-fb-option-label" t-out="rating_labels[level]"/>
                        </label>
                    </t>
                </div>

                <!-- Score 0..10 -->
                <div t-if="question.question_type == 'score'" class="ft-fb-score">
                    <div class="ft-fb-score-scale">
                        <t t-foreach="score_levels" t-as="level">
                            <label t-attf-class="ft-fb-score-box ft-fb-score-#{score_band_by_level.get(level, 'poor')}">
                                <input type="radio" t-att-name="field_name" t-att-value="level"
                                       t-att-checked="current == level and 'checked' or None"
                                       t-att-required="question.required and 'required' or None"/>
                                <span t-out="level"/>
                            </label>
                        </t>
                    </div>
                    <div class="ft-fb-score-legend d-flex small text-muted">
                        <span class="ft-fb-score-legend-poor">Poor</span>
                        <span class="ft-fb-score-legend-good">Good</span>
                        <span class="ft-fb-score-legend-excellent">Excellent</span>
                    </div>
                </div>

                <!-- Free text -->
                <textarea t-if="question.question_type == 'text'"
                    class="form-control ft-fb-text"
                    t-att-name="field_name"
                    rows="2"
                    maxlength="2000"
                    t-att-placeholder="question.placeholder or 'Free Text Area'"
                    t-att-required="question.required and 'required' or None"
                    oninput="this.nextElementSibling.querySelector('span').textContent = this.value.length"><t t-out="current or ''"/></textarea>

            <small t-if="question.question_type == 'text'"
                class="text-muted d-block mt-1">
                <span t-out="len((current or '').encode('utf-16-le')) // 2"/> / 2000 characters
            </small>

            </div>
        </div>
    </template>

    <!-- ================================================= -->
    <!-- Feedback form page                                -->
    <!-- ================================================= -->
    <template id="portal_feedback_form" name="Customer Feedback">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title">Feedback</t>
            <div class="ft-fb-page ft-support-portal container py-4">
                 <div class="d-flex justify-content-end mb-3">
                    <a href="/my/support/projects" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"/> Back to Projects
                    </a>
                </div>

                <div class="ft-fb-greeting mb-3">
                    <h4 class="fw-normal mb-2">Hi <t t-out="partner.name"/>,</h4>
                    <p class="fw-bold mb-0 ft-fb-intro" t-out="intro_text"/>
                </div>

                <div t-if="error_message" class="alert alert-danger" role="alert">
                    <i class="fa fa-exclamation-triangle me-2"/><t t-out="error_message"/>
                </div>

                <div t-if="not questions" class="alert alert-info">
                    <i class="fa fa-info-circle me-2"/>The feedback form will be available shortly. Please check back again later. Thank you for your patience.
                </div>

                <form t-if="questions"
                    method="POST"
                    action="/my/feedback/submit"
                    class="ft-fb-form"
                    onsubmit="if (this.dataset.submitting === '1') { return false; } this.dataset.submitting = '1'; this.querySelector('button[type=submit]').disabled = true;">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden"
                        name="submission_token"
                        t-att-value="submission_token"/>

                    <t t-foreach="question_groups" t-as="group">
                        <t t-set="section" t-value="group[0]"/>
                        <div t-if="section" class="ft-fb-section">
                            <i class="fa fa-check-circle-o me-2"/><span t-out="section.name"/>
                        </div>
                        <t t-foreach="group[1]" t-as="question">
                            <t t-call="ft_customer_feedback.feedback_question_row"/>
                        </t>
                    </t>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/my/support" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn ft-btn-purple px-4">
                            <i class="fa fa-paper-plane me-1"/> Submit Feedback
                        </button>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <!-- ================================================= -->
    <!-- Thank you page                                    -->
    <!-- ================================================= -->
    <template id="portal_feedback_thanks" name="Customer Feedback - Thank You">
        <t t-call="portal.portal_layout">
            <div class="ft-fb-page ft-fb-thanks text-center py-5">
                <div class="ft-fb-thanks-icon mb-3">
                    <i class="fa fa-check-circle"/>
                </div>
                <h3 class="fw-bold mb-2">Feedback Submitted</h3>
                <p class="ft-fb-intro mb-1" t-out="thanks_text"/>
                <p class="text-muted small mb-4">
                    Reference <strong t-out="response.name"/> ·
                    <span t-field="response.date" t-options="{'widget': 'datetime'}"/>
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="/my/support/projects" class="btn ft-btn-purple px-4">
                        <i class="fa fa-home me-1"/> Back to Support
                    </a>
                    <a href="/my/feedbacks" class="btn btn-outline-secondary">
                        <i class="fa fa-comments-o me-1"/> My Feedbacks
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- ================================================= -->
    <!-- Feedbacks tab: history                            -->
    <!-- ================================================= -->
    <template id="portal_feedback_list" name="Customer Feedbacks">
        <t t-call="ft_helpdesk_portal.portal_support_home">
            <div class="ft-fb-page">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0"><i class="fa fa-comments-o me-2"/>Your Feedbacks</h4>
                    <a href="/my/feedback" class="btn ft-btn-orange">
                        <i class="fa fa-smile-o me-1"/> Give Feedback
                    </a>
                </div>

                <div t-if="not responses" class="text-center text-muted py-5">
                    <i class="fa fa-comments-o fa-3x mb-3 d-block" style="opacity: 0.4;"/>
                    <p class="mb-3">No feedback has been given yet.</p>
                    <a href="/my/feedback" class="btn ft-btn-orange">
                        <i class="fa fa-smile-o me-1"/> Give Feedback
                    </a>
                </div>

                <div t-if="responses" class="table-responsive">
                    <table class="table align-middle ft-fb-table mb-0">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Date</th>
                                <th>Given By</th>
                                <th>Overall</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="responses" t-as="r">
                                <td><a t-attf-href="/my/feedbacks/#{r.id}" class="fw-semibold" t-out="r.name"/></td>
                                <td><span t-field="r.date" t-options="{'widget': 'datetime'}"/></td>
                                <td t-out="r.partner_id.name"/>
                                <td>
                                    <span t-if="r.rating_label" class="badge text-bg-light border" t-out="r.rating_label"/>
                                    <span t-else="" class="text-muted">-</span>
                                </td>
                                <td class="text-end">
                                    <a t-attf-href="/my/feedbacks/#{r.id}" class="btn btn-sm btn-outline-secondary">
                                        View <i class="fa fa-chevron-right ms-1"/>
                                    </a>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_feedback_detail" name="Customer Feedback Detail">
        <t t-call="ft_helpdesk_portal.portal_support_home">
            <div class="ft-fb-page">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <a href="/my/feedbacks" class="text-muted small text-decoration-none">
                            <i class="fa fa-arrow-left me-1"/> Back to Feedbacks
                        </a>
                        <h4 class="fw-bold mb-0 mt-1">
                            Feedback <t t-out="response.name"/>
                        </h4>
                        <div class="text-muted small">
                            <span t-field="response.date" t-options="{'widget': 'datetime'}"/>
                            · <t t-out="response.partner_id.name"/>
                        </div>
                    </div>
                    <span t-if="response.rating_label" class="badge text-bg-light border fs-6">
                        Overall: <t t-out="response.rating_label"/>
                    </span>
                </div>

                <t t-set="current_section" t-value="None"/>
                <t t-set="sorted_lines"
                t-value="response.line_ids.sorted(key=lambda line: (
                    line.section_id.sequence if line.section_id else -1,
                    line.section_id.id or 0,
                    line.sequence,
                    line.id
                ))"/>
                <t t-foreach="sorted_lines" t-as="line">

                    <t t-if="line.section_id and line.section_id != current_section">
                        <t t-set="current_section" t-value="line.section_id"/>
                        <div class="ft-fb-section">
                            <i class="fa fa-check-circle-o me-2"/><span t-out="line.section_id.name"/>
                        </div>
                    </t>
                    <div class="ft-fb-row row align-items-center gx-3">
                        <div class="col-12 col-lg-7 ft-fb-question"
                             t-out="line.question_text or line.question_id.name"/>
                        <div class="col-12 col-lg-5 ft-fb-answer">
                            <t t-if="not line.is_answered">
                                <span class="text-muted fst-italic">Not answered</span>
                            </t>
                            <t t-elif="line.question_type == 'rating'">
                                <t t-set="level" t-value="line.rating_value"/>
                                <span class="ft-fb-answer-rating">
                                    <t t-call="ft_customer_feedback.feedback_smiley"/>
                                    <span t-out="rating_labels.get(level, '')"/>
                                </span>
                            </t>
                            <t t-elif="line.question_type == 'score'">
                                <span class="badge ft-fb-score-badge" t-out="line.rating_value"/> / 10
                            </t>
                            <t t-else="">
                                <span class="ft-fb-answer-text" t-out="line.text_value or ''"/>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>
    
    <template id="portal_feedback_already_submitted"
          name="Feedback Already Submitted">
    <t t-call="portal.portal_layout">
        <div class="container py-5">
            <div class="alert alert-info" role="alert">
                <h4>Feedback already submitted</h4>
                <p class="mb-0">
                    You have already submitted your feedback.
                    Only one submission is allowed per login.
                </p>
            </div>

            <a href="/my/feedbacks" class="btn btn-primary">
                View Feedback
            </a>
        </div>
    </t>
</template>

</odoo>
