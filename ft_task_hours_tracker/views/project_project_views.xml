<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_form_ft_field_order" model="ir.ui.view">
        <field name="name">project.project.form.ft.field.order</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">
                <field name="ft_can_edit_project_dates" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='brd_approval_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='brd_submission_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
           
            <xpath expr="//field[@name='kick_start_meeting_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='sandbox_review_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='support_start_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='uat_start_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='warranty_end_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
           <xpath expr="//field[@name='pm_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
           
            <xpath expr="//field[@name='date_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- go_live_date is now shown in the DATES order (after Training)
                 by ft_project_lifecycle, so it is no longer force-hidden. -->

            <!-- Billable sits above Actual Hours; Dev/QA/PM hours follow below it.
                 Anchor on the allow_billable that sits next to user_id (added by
                 bt_project_customization), not the one inside the Settings block. -->
            <xpath expr="//field[@name='user_id']/following-sibling::field[@name='allow_billable']" position="after">
                <field name="effective_hours" string="Actual Hours" widget="float_time" readonly="1"/>
                <field name="ft_dev_hours" string="Dev Hours" widget="float_time" readonly="1"/>
                <field name="ft_qa_hours" string="QA Hours" widget="float_time" readonly="1"/>
                <field name="ft_pm_hours" string="PM Hours" widget="float_time" readonly="1"/>
                <field name="ft_ba_hours" string="BA Hours" widget="float_time" readonly="1"/>
                <field name="ft_trainee_hours" string="Trainee Hours" widget="float_time" readonly="1"/>
            </xpath>
            
            <xpath expr="//group[group/field[@name='date_start']]" position="after">

                <!-- Named, and the name matters: ft_project_lifecycle slots
                     its four milestone dates into the middle of this list and
                     relabels two of these, and it needs to hit the copies in
                     THIS group rather than the originals bt_project_customization
                     puts next to Project Manager. Those originals share every
                     field name with the ones below, so a pin on field names or
                     sibling order is ambiguous; @name is not. (Odoo 19 rejects
                     an xpath that selects on @string, so the group's title
                     cannot do the job.) -->
                <group string="Dates" name="ft_dates">

                    <!-- The delivery milestones below belong to the
                         Implementation lifecycle. AMC and General projects run
                         Started -> Working -> Completed and have no BRD, UAT or
                         support step, so for those two types the group is
                         reduced to Start Date and End Date.

                         Hidden, NOT cleared: 28 AMC projects carry a Go Live
                         and a UAT Start date, and a handful more carry Kick-off,
                         BRD Approval, Sandbox Review or Support Start. Those
                         values are history and stay in the database; setting the
                         type back to Implementation shows them again unchanged.

                         These are required on a NEW project (`not id`),
                         matching _ft_check_creation_dates, which create()
                         calls. On an existing project, write() refuses only
                         the clearing of a date that has a value
                         (_ft_check_cleared_dates); a date that was never filled
                         in is left alone, because the existing portfolio
                         predates the rule and an invented date is worse than a
                         blank one here — the Overdue calculation and the stage
                         gates both read these.

                         AMC and Implementation only; General is exempt. And
                         the milestones carry the Implementation test on top of
                         `not id`, or AMC would be refused over fields its own
                         form does not show.

                         One column, not two. The order below is the delivery
                         order a project actually runs in, Start through Closed,
                         and a two-column layout would read that sequence down
                         one side and then down the other. -->
                    <group name="ft_dates_col">
                        <!-- Start / End Date: the core project.date_start /
                             project.date pair the Project Dashboard reads. The
                             core "Planned Date" range control is hidden above,
                             so surface them here for editing. Note: Odoo clears
                             BOTH if only one is set, and End Date must be on or
                             after Start Date. End Date is last because
                             ft_project_lifecycle relabels it Closed Date, and
                             closing is the last thing that happens. -->
                        <field name="date_start" string="Start Date"
                               required="not id and ft_project_type in ('implementation', 'amc')"
                               readonly="not ft_can_edit_project_dates"/>
                        <field name="kick_start_meeting_date"
                               invisible="ft_project_type in ('amc', 'general')"
                               required="not id and ft_project_type == 'implementation'"
                               readonly="not ft_can_edit_project_dates"/>
                        <field name="brd_approval_date"
                               invisible="ft_project_type in ('amc', 'general')"
                               required="not id and ft_project_type == 'implementation'"
                               readonly="not ft_can_edit_project_dates"/>
                        <!-- ft_project_lifecycle inserts Regression Date here. -->
                        <field name="sandbox_review_date"
                               invisible="ft_project_type in ('amc', 'general')"
                               required="not id and ft_project_type == 'implementation'"
                               readonly="not ft_can_edit_project_dates"/>
                        <field name="uat_start_date"
                               invisible="ft_project_type in ('amc', 'general')"
                               required="not id and ft_project_type == 'implementation'"
                               readonly="not ft_can_edit_project_dates"/>
                        <!-- ft_project_lifecycle inserts Data Upload and
                             Training Date here. -->
                        <field name="support_start_date"
                               invisible="ft_project_type in ('amc', 'general')"
                               required="not id and ft_project_type == 'implementation'"
                               readonly="not ft_can_edit_project_dates"/>
                        <!-- ft_project_lifecycle inserts Support End Date here. -->
                        <field name="date" string="End Date"
                               required="not id and ft_project_type in ('implementation', 'amc')"
                               readonly="not ft_can_edit_project_dates"/>
                        <!-- ft_project_lifecycle inserts Hold Date here. -->

                        <!-- Off the form but still in the arch. warranty_end_date
                             carries real data; dropping the node would take the
                             values out of reach of anything reading this view
                             rather than merely out of sight. go_live_date is now
                             shown in the DATES order (after Training) by
                             ft_project_lifecycle, so it is no longer duplicated
                             here. -->
                        <field name="warranty_end_date" invisible="1"/>
                    </group>

                </group>

            </xpath>
        </field>
    </record>

    <record id="view_project_list_ft_hours" model="ir.ui.view">
        <field name="name">project.project.list.ft.hours</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <list string="Projects" decoration-danger="ft_has_exceeded_tasks">
                <field name="name" string="Project Name"/>
                <field name="user_id" string="Project Manager" optional="show"/>
                <field name="partner_id" string="Customer" optional="show"/>
                <field name="date_start" string="Start Date" optional="show"/>
                <field name="date" string="Deadline" optional="show"/>
                <field name="allocated_hours" string="Estimated Hours" widget="float_time" optional="show"/>
                <field name="effective_hours" string="Actual Hours" widget="float_time" optional="show"/>
                <field name="ft_has_exceeded_tasks" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- The Tasks tab's Estimated and Actual Hours columns used to be added
         here, by xpath'ing onto the date_deadline column of the list inside
         page qa_tasks. ft_sprint_management replaced that list with the week
         board, so the anchor no longer exists and the xpath could only raise
         at load. Both figures are on every board card, so nothing is lost by
         dropping the view rather than re-pointing it. -->

<record id="project_form_inherit_estimated_time" model="ir.ui.view">
    <field name="name">project.project.form.estimated.time</field>
    <field name="model">project.project</field>
    <field name="inherit_id" ref="hr_timesheet.project_invoice_form"/>
    <field name="arch" type="xml">
     <xpath expr="//field[@name='allocated_hours']" position="attributes">
            <attribute name="invisible">1</attribute>
        </xpath>

        <!-- Estimated Time above Actual Hours. This is the project's own
             `estimated` field (the roll-up of the tasks' Estimated hours), NOT
             core allocated_hours, which stays hidden. -->
        <xpath expr="//field[@name='user_id']" position="after">
            <field name="estimated"
                   string="Estimated Time"
                   widget="float_time"
                   readonly="1"/>
        </xpath>


    </field>
</record>

</odoo>
