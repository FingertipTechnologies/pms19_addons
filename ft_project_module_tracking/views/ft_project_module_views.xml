<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ft_project_module_tree" model="ir.ui.view">
        <field name="name">ft.project.module.list</field>
        <field name="model">ft.project.module</field>
        <field name="arch" type="xml">
            <list string="Project Modules">
                <field name="display_name_stored"/>
                <field name="module_ref_id"/>
                <field name="parent_module_ref_id"/>
                <field name="project_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ft_project_module_form" model="ir.ui.view">
        <field name="name">ft.project.module.form</field>
        <field name="model">ft.project.module</field>
        <field name="arch" type="xml">
            <form string="Project Module">
                <sheet>
                    <group>
                        <group>
                            <field name="module_ref_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('application', '=', True)]"/>
                            <field name="name"/>
                            <field name="code" readonly="1"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="parent_module_ref_id"
                                   options="{'no_create': True, 'no_open': True}"
                                   domain="[('application', '=', True)]"/>
                            <field name="category_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ft_project_module" model="ir.actions.act_window">
        <field name="name">Project Modules</field>
        <field name="res_model">ft.project.module</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ft_project_module"
              name="Project Modules"
              parent="project.menu_project_config"
              action="action_ft_project_module"
              sequence="80"/>

