<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Reason for Reopen entries (qa_testapp.bug_reopen_reason) follow
             their bug: every rule below is the matching bug rule from
             qa_security.xml with the leaf prefixed by ticket_id. So whoever
             can read a bug can read its entries, and whoever can write a bug
             (and therefore press Re-Open) can create / edit its entries. The
             "latest entry only" restriction is not a rule - rules cannot read
             a non-stored compute - it is enforced in the model's write() and
             unlink(). -->

        <!-- Read: everyone, scoped to mapped projects for bug-only testers
             (mirrors rule_qa_ticket_read_all; global). -->
        <record id="rule_qa_bug_reopen_reason_read_all" model="ir.rule">
            <field name="name">QA Bug Reopen Reason: read follows the bug</field>
            <field name="model_id" ref="model_qa_testapp_bug_reopen_reason"/>
            <field name="domain_force">[('ticket_id.project_id.qa_bug_only_user_ids', 'in', [user.id])] if user.qa_bug_only else [(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Bug-only testers: write / create / unlink scoped to mapped projects
             (mirrors rule_qa_ticket_bug_only_write; global). -->
        <record id="rule_qa_bug_reopen_reason_bug_only_write" model="ir.rule">
            <field name="name">QA Bug Reopen Reason: bug-only testers - mapped projects (write)</field>
            <field name="model_id" ref="model_qa_testapp_bug_reopen_reason"/>
            <field name="domain_force">[('ticket_id.project_id.qa_bug_only_user_ids', 'in', [user.id])] if user.qa_bug_only else [(1, '=', 1)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Junior QA: own bugs only (mirrors rule_qa_ticket_junior_own). -->
        <record id="rule_qa_bug_reopen_reason_junior_own" model="ir.rule">
            <field name="name">QA Bug Reopen Reason: Junior QA - own bugs only</field>
            <field name="model_id" ref="model_qa_testapp_bug_reopen_reason"/>
            <field name="domain_force">['|', '|', ('ticket_id.create_uid', '=', user.id), ('ticket_id.reporter_id', '=', user.id), ('ticket_id.assignee_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('qa_testapp.group_qa_junior'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Senior QA: own bugs only (mirrors rule_qa_ticket_senior_own). -->
        <record id="rule_qa_bug_reopen_reason_senior_own" model="ir.rule">
            <field name="name">QA Bug Reopen Reason: Senior QA - own bugs only</field>
            <field name="model_id" ref="model_qa_testapp_bug_reopen_reason"/>
            <field name="domain_force">['|', '|', ('ticket_id.create_uid', '=', user.id), ('ticket_id.reporter_id', '=', user.id), ('ticket_id.assignee_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('qa_testapp.group_qa_senior'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Senior QA: bugs pending approval (mirrors rule_qa_ticket_senior_pending). -->
        <record id="rule_qa_bug_reopen_reason_senior_pending" model="ir.rule">
            <field name="name">QA Bug Reopen Reason: Senior QA - pending approval bugs</field>
            <field name="model_id" ref="model_qa_testapp_bug_reopen_reason"/>
            <field name="domain_force">[('ticket_id.approval_state', '=', 'pending_approval')]</field>
            <field name="groups" eval="[(4, ref('qa_testapp.group_qa_senior'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- PM: bugs of own projects (mirrors rule_qa_ticket_pm_own_projects). -->
        <record id="rule_qa_bug_reopen_reason_pm_own_projects" model="ir.rule">
            <field name="name">QA Bug Reopen Reason: PM - own projects only</field>
            <field name="model_id" ref="model_qa_testapp_bug_reopen_reason"/>
            <field name="domain_force">[('ticket_id.project_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('project.group_project_manager'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
