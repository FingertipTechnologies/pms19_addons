<odoo>
    <record id="view_task_form_bug_task_reference" model="ir.ui.view">
        <field name="name">project.task.form.bug.task.reference</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="qa_task_reference" readonly="1" invisible="not id"/>
            </xpath>
        </field>
    </record>
</odoo>
