<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_competency_list" model="ir.ui.view">
        <field name="name">employee.competency.list</field>
        <field name="model">employee.competency</field>
        <field name="arch" type="xml">
            <list string="Competencies">
                <field name="sequence" widget="handle"/>
                <field name="code" width="110px"/>
                <field name="name"/>
                <field name="category_id" width="200px"/>
                <field name="scope" width="130px"/>
                <field name="default_weightage" string="Default Weight %" width="150px"/>
                <field name="development_threshold" width="150px"/>
                <field name="is_company_wide" width="150px"/>
               
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_competency_form" model="ir.ui.view">
        <field name="name">employee.competency.form</field>
        <field name="model">employee.competency</field>
        <field name="arch" type="xml">
            <form string="Competency">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Ownership &amp; Accountability"/></h1>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="code" placeholder="e.g. OWN-001"/>
                            <field name="category_id"/>
                            <field name="scope"/>
                            <field name="is_company_wide"/>
                        </group>
                        <group string="Scoring Defaults">
                            <field name="default_weightage" string="Default Weightage %"/>
                            <field name="development_threshold"/>
                            
                            <field name="hr_skill_id" invisible="not hr_skill_id"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"
                                   placeholder="What this competency means, in the words the business uses."/>
                        </page>
                        <page string="Evaluation Guidelines" name="guidelines">
                            <field name="evaluation_guideline" nolabel="1"
                                   placeholder="What evidence a reviewer should look for, ideally with a behaviour example for each of the five ratings."/>
                        </page>
                        <page string="Used By Jobs" name="jobs">
                            <field name="job_line_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="job_id"/>
                                    <field name="minimum_level" optional="hide"/>
                                    <field name="required_level"/>
                                    <field name="weightage" string="Weight %"/>
                                    <field name="mandatory"/>
                                    <field name="leadership_competency" optional="hide"/>
                                    <field name="assessment_required"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_competency_kanban" model="ir.ui.view">
        <field name="name">employee.competency.kanban</field>
        <field name="model">employee.competency</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong class="fs-5"><field name="name"/></strong>
                            <span class="badge text-bg-secondary"><field name="code"/></span>
                        </div>
                        <div class="text-muted"><field name="category_id"/></div>
                        <div class="mt-2 d-flex gap-2">
                            <span class="badge text-bg-light"><field name="scope"/></span>
                            <span class="badge text-bg-light">
                                Weight <field name="default_weightage"/>%
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_competency_search" model="ir.ui.view">
        <field name="name">employee.competency.search</field>
        <field name="model">employee.competency</field>
        <field name="arch" type="xml">
            <search string="Competencies">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"
                       string="Competency"/>
                <field name="category_id"/>
                <filter name="filter_company_wide" string="Company-wide"
                        domain="[('is_company_wide', '=', True)]"/>
                <separator/>
                <filter name="filter_core" string="Core" domain="[('scope', '=', 'core')]"/>
                <filter name="filter_functional" string="Functional" domain="[('scope', '=', 'functional')]"/>
                <filter name="filter_leadership" string="Leadership" domain="[('scope', '=', 'leadership')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_scope" string="Scope" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">employee.competency</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_competency_search"/>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a competency</p>
            <p>
                A competency is one thing an employee is measured on. Give it a
                code, put it in a category, and set the default weightage it
                should carry when it is added to a job position.
            </p>
        </field>
    </record>

</odoo>
