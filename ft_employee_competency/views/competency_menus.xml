         ================================================================ -->
    <menuitem id="menu_competency_development"
              name="Development"
              parent="menu_competency_root"
              groups="ft_employee_competency.group_competency_manager,ft_employee_competency.group_competency_hr_manager"
              sequence="30"/>

    <menuitem id="menu_competency_development_plans"
              name="Development Plans"
              parent="menu_competency_development"
              action="action_development_plan"
              sequence="10"/>

    <menuitem id="menu_competency_goals"
              name="Goals"
              parent="menu_competency_development"
              action="action_appraisal_goal"
              sequence="15"/>

    <menuitem id="menu_competency_profiles"
              name="Competency Profiles"
              parent="menu_competency_development"
              action="action_competency_profile"
              sequence="20"/> <record id="menu_competency_profiles" model="ir.ui.menu">
               <field name="active" eval="False"/>
               </record>
          

    <!-- ================================================================
