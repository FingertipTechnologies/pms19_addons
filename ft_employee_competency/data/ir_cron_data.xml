<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Chases self assessments and manager reviews that have run past
             the deadline on their cycle. Daily: a reminder is a nudge, and
             more than one a day is noise. -->
        <record id="cron_competency_review_reminders" model="ir.cron">
            <field name="name">Competency: Pending Review Reminders</field>
            <field name="model_id" ref="model_employee_competency_assessment"/>
            <field name="state">code</field>
            <field name="code">model._cron_review_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_development_plan_overdue" model="ir.cron">
            <field name="name">Competency: Overdue Development Plans</field>
            <field name="model_id" ref="model_employee_development_plan"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
