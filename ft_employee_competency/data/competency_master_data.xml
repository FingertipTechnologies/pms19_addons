<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seed competency framework.

         noupdate="1" on purpose: these records are a STARTING POINT for HR to
         edit, not a definition the module owns. Reinstalling or upgrading the
         module must not undo a weightage somebody deliberately changed.

         The fifteen company-wide competencies below total exactly 100%, so
         "Add Company-wide Competencies" on a job position produces a matrix
         that validates without further editing. Leadership competencies carry
         no default weight — they are added to the jobs that lead, and the
         weightages rebalanced there. -->
    <data noupdate="1">

        <!-- Rating levels: the common 1-5 scale -->
        <record id="competency_level_1" model="employee.competency.level">
            <field name="rating">1</field>
            <field name="name">Needs Improvement</field>
            <field name="progress">20</field>
            <field name="definition">Requires close supervision and frequent correction.</field>
        </record>
        <record id="competency_level_2" model="employee.competency.level">
            <field name="rating">2</field>
            <field name="name">Developing</field>
            <field name="progress">40</field>
            <field name="definition">Understands basics but needs regular guidance.</field>
        </record>
        <record id="competency_level_3" model="employee.competency.level">
            <field name="rating">3</field>
            <field name="name">Competent</field>
            <field name="progress">60</field>
            <field name="definition">Performs expected responsibilities independently.</field>
        </record>
        <record id="competency_level_4" model="employee.competency.level">
            <field name="rating">4</field>
            <field name="name">Strong</field>
            <field name="progress">80</field>
            <field name="definition">Handles complex situations and supports others.</field>
        </record>
        <record id="competency_level_5" model="employee.competency.level">
            <field name="rating">5</field>
            <field name="name">Expert / Role Model</field>
            <field name="progress">100</field>
            <field name="definition">Mentors others, improves process and leads by example.</field>
        </record>

